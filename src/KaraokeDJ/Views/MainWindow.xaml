<Window x:Class="KaraokeDJ.Views.MainWindow" FontFamily="{StaticResource UiFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:KaraokeDJ.Views"
        xmlns:vm="clr-namespace:KaraokeDJ.ViewModels"
        xmlns:m="clr-namespace:KaraokeDJ.Models"
        Title="Mixfonia" Width="1500" Height="960" MinWidth="940" MinHeight="600"
        Background="{StaticResource WindowBgBrush}" WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <!-- L'interfaccia si rimpicciolisce da sola quando la finestra è più piccola del formato di riferimento
         (portatili 13", schermi scalati al 125/150 %): vedi MainWindow.ApplyUiScale. -->
    <Grid x:Name="Root" Margin="10">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ barra strumenti ═══════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Content="{Binding UpdateStatus, StringFormat=⬆ {0} — installa e riavvia}" Style="{StaticResource AccentButton}" Command="{Binding InstallUpdateCommand}" Margin="0,0,10,0"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                <Button Content="⬆ Rinnova aggiornamenti (10 €/anno)" Style="{StaticResource AccentButton}" Click="Renew_Click" Margin="0,0,10,0" ToolTip="{Binding UpdateStatus}"
                        Visibility="{Binding UpdateBlocked, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisInv}}"/>
                <Button Content="{Binding AppVersion, StringFormat=⬆ {0}}" Style="{StaticResource SmallButton}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,10,0" ToolTip="Controlla se ci sono aggiornamenti su GitHub"/>
                <Button Content="✅" Style="{StaticResource SmallButton}" Click="Preflight_Click" Height="26" Padding="7,0" Margin="0,0,3,0"
                        ToolTip="Controllo pre-serata&#10;Audio, cuffia, microfono, proiettore, licenza, disco, libreria, console: cosa manca prima di cominciare."/>
                <ToggleButton IsChecked="{Binding BottomStripVisible}" Style="{StaticResource ToolToggle}" Content="🎛" ToolTip="Pad e importazione&#10;Mostra/nascondi la striscia in basso (jingle e importazione) per dare spazio a libreria e coda."/>
                <ToggleButton IsChecked="{Binding MixViewVisible}" Style="{StaticResource ToolToggle}" Content="〰" ToolTip="Vista mix&#10;Onde dei due deck sovrapposte con la griglia dei battiti, per allineare a occhio."/>
                <ToggleButton IsChecked="{Binding IsMonitorOpen}" Style="{StaticResource ToolToggle}" Content="👁" v:Shortcut.Action="monitor" ToolTip="Monitor proiettore&#10;Finestrella sempre in primo piano con quello che vede il pubblico (CDG, testo, video, dediche, QR)."/>
                <ToggleButton IsChecked="{Binding IsProjectorOpen}" Style="{StaticResource ToolToggle}" Content="🖥" Margin="0" v:Shortcut.Action="projector" ToolTip="Proiettore (Ctrl+P)&#10;Apre/chiude lo schermo per il pubblico sul secondo monitor."/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/wordmark.png" Height="34" Margin="0,0,18,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Mixfonia – Mix · Sing · Together">
                </Image>
                <Button Content="📁" Style="{StaticResource ToolIcon}" Command="{Binding AddFolderCommand}" ToolTip="Aggiungi cartella&#10;Scegli una cartella con musica o basi karaoke da mettere in libreria."/>
                <Button Content="🔄" Style="{StaticResource ToolIcon}" Command="{Binding RescanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" ToolTip="Riscansiona&#10;Rilegge le cartelle: nuovi brani, tag (anno, genere), titoli/artisti sistemati, poi analisi BPM/tonalità di ciò che manca. Di norma non serve: i file nuovi entrano da soli."/>
                <Button Content="🧹" Style="{StaticResource ToolIcon}" Click="Duplicates_Click" ToolTip="Doppioni&#10;Trova le copie doppie e le manda nel Cestino per liberare spazio (in libreria ne vedi già una sola)."/>
                <Button Content="🥁" Style="{StaticResource ToolIcon}" Click="Rhythm_Click" ToolTip="Ritmi&#10;Sequencer di supporto: batteria, percussioni o campioni tuoi agganciati ai BPM della serata."/>
                <Button Content="📱" Style="{StaticResource ToolIcon}" Click="Remote_Click" ToolTip="Scaletta remota&#10;QR per gestire la scaletta dal telefono: coda, ricerca, mix now."/>
                <Button Content="📋" Style="{StaticResource ToolIcon}" Click="Bordero_Click" ToolTip="Borderò SIAE&#10;Programma musicale della serata: brani riprodotti con titolo e autori, da stampare o copiare nel modulo SIAE."/>
                <Button Content="⚙" Style="{StaticResource ToolIcon}" Click="Settings_Click" ToolTip="Impostazioni&#10;Audio, proiettore, cartelle, AI, MIDI e tastiera, plugin e fonti."/>
                <Button Content="🎉" Style="{StaticResource ToolIcon}" Click="Animation_Click" ToolTip="Animazione&#10;Festeggiato, messaggi degli invitati, canzone con Suno, dedica sul proiettore."/>
                <Button Content="❤" Click="Support_Click" ToolTip="{Binding SupportLabel, StringFormat=Licenza Mixfonia&#10;{0}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolIcon}">
                            <Setter Property="Foreground" Value="{StaticResource MagentaBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLicensed}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentABrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>
        </DockPanel>

        <!-- ═══════════ vista di mixaggio: onde sovrapposte ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="4" Margin="0,0,0,8" Visibility="{Binding MixViewVisible, Converter={StaticResource BoolToVis}}">
            <v:MixWaveView Height="60"
                           DataA="{Binding DeckA.FineWaveform}" DataB="{Binding DeckB.FineWaveform}"
                           PosA="{Binding DeckA.PositionSec}" PosB="{Binding DeckB.PositionSec}"
                           BpmA="{Binding DeckA.NativeBpm}" BpmB="{Binding DeckB.NativeBpm}"
                           TempoA="{Binding DeckA.TempoFactor}" TempoB="{Binding DeckB.TempoFactor}"
                           AnchorA="{Binding DeckA.GridAnchorSec}" AnchorB="{Binding DeckB.GridAnchorSec}"
                           BeatsA="{Binding DeckA.Beats}" BeatsB="{Binding DeckB.Beats}"
                           AccentA="{StaticResource AccentABrush}" AccentB="{StaticResource AccentBBrush}"
                           ToolTip="Onde dei due deck sovrapposte (A sopra, B sotto) centrate sull'istante attuale, con la griglia dei battiti. Rotella = zoom. Metti il CUE su un battere per allineare la griglia."/>
        </Border>

        <!-- ═══════════ deck + mixer ═══════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="276"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <v:DeckControl Grid.Column="0" DataContext="{Binding DeckA}" Accent="{StaticResource AccentABrush}"/>

            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <Button Grid.Row="0" Content="⏭  PROSSIMO IN CODA" v:Shortcut.Action="next" Style="{StaticResource AccentButton}" Height="34" FontSize="12.5"
                            Command="{Binding PlayNextCommand}" ToolTip="Carica il primo in coda sull'altro deck, lo avvia e sfuma (Ctrl+N)"/>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <!-- mixer: manopole all'esterno (verso il deck), fader di canale sopra il VU verticale, master al centro con VU stereo, cuffie e mic -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <v:Knob Label="TRIM" Value="{Binding DeckA.GainDb}" Minimum="-24" Maximum="12" Diameter="24" DefaultValue="0" Accent="{StaticResource AccentABrush}" v:Shortcut.Action="a.volume" ToolTip="{Binding DeckA.GainLabel, StringFormat=Trim A: {0}}"/>
                                <v:Knob Label="HI" Value="{Binding DeckA.EqHigh}" Minimum="-12" Maximum="12" Diameter="24" Bipolar="True" Accent="{StaticResource AccentABrush}" IsKilled="{Binding DeckA.EqHighKill}" v:Shortcut.Action="a.eqhigh" RightClick="KillHighA" ToolTip="EQ alti A · tasto destro = kill · doppio click = 0"/>
                                <v:Knob Label="MID" Value="{Binding DeckA.EqMid}" Minimum="-12" Maximum="12" Diameter="24" Bipolar="True" Accent="{StaticResource AccentABrush}" IsKilled="{Binding DeckA.EqMidKill}" v:Shortcut.Action="a.eqmid" RightClick="KillMidA" ToolTip="EQ medi A · tasto destro = kill · doppio click = 0"/>
                                <v:Knob Label="LOW" Value="{Binding DeckA.EqLow}" Minimum="-12" Maximum="12" Diameter="24" Bipolar="True" Accent="{StaticResource AccentABrush}" IsKilled="{Binding DeckA.EqLowKill}" v:Shortcut.Action="a.eqlow" RightClick="KillLowA" ToolTip="EQ bassi A · tasto destro = kill · doppio click = 0"/>
                                <v:Knob Label="FILTER" Value="{Binding DeckA.FilterValue}" Minimum="-1" Maximum="1" Diameter="24" Bipolar="True" Accent="{StaticResource WarnBrush}" v:Shortcut.Action="a.filtervalue" ToolTip="Filtro A: sinistra low-pass, destra high-pass (doppio click = off)"/>
                                <v:Knob Label="PAN" Value="{Binding DeckA.Pan}" Minimum="-1" Maximum="1" Diameter="24" Bipolar="True" Accent="{StaticResource TextBrush}" v:Shortcut.Action="a.pan" ToolTip="{Binding DeckA.PanLabel, StringFormat=Pan A: {0}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="4,0">
                                <ToggleButton Content="🎧" IsChecked="{Binding DeckA.CueOn}" v:Shortcut.Action="a.cuepfl" Style="{StaticResource ToolToggle}" Padding="0" Width="28" Height="20" MinWidth="0" FontSize="10" Margin="0,2,0,6" ToolTip="Pre-ascolto in cuffia del deck A"/>
                                <Grid Height="190" Width="28">
                                    <v:LevelMeter Left="{Binding DeckA.LevelL}" Right="{Binding DeckA.LevelR}" Vertical="True" Width="12" Height="190" HorizontalAlignment="Center" ToolTip="Livello deck A (dopo trim e fader)"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding DeckA.Fader}" Width="190" Height="28" Background="Transparent" v:Shortcut.Action="a.fader" Foreground="Transparent" ToolTip="Fader di canale A">
                                        <Slider.LayoutTransform><RotateTransform Angle="-90"/></Slider.LayoutTransform>
                                    </Slider>
                                </Grid>
                                <TextBlock Text="A" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource AccentABrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="6,0">
                                <TextBlock Text="MASTER" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,4,0,4"/>
                                <Grid Height="146" Width="34">
                                    <v:LevelMeter Left="{Binding MasterL}" Right="{Binding MasterR}" Vertical="True" Width="20" Height="146" HorizontalAlignment="Center" ToolTip="Uscita master: sinistra e destra"/>
                                    <Slider Minimum="0" Maximum="1.2" Value="{Binding MasterVolume}" Width="146" Height="34" Background="Transparent" v:Shortcut.Action="master" Foreground="Transparent" ToolTip="Volume master">
                                        <Slider.LayoutTransform><RotateTransform Angle="-90"/></Slider.LayoutTransform>
                                    </Slider>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <v:Knob Label="CUE" Value="{Binding CueVolume}" Minimum="0" Maximum="1.5" DefaultValue="1" Diameter="24" Accent="{StaticResource TextBrush}" v:Shortcut.Action="cuevolume" Margin="0,0,4,0" ToolTip="Volume cuffie (pre-ascolto)"/>
                                    <v:Knob Label="MIC" Value="{Binding MicGainDb}" Minimum="-24" Maximum="24" DefaultValue="0" Diameter="24" Accent="{StaticResource TextBrush}" v:Shortcut.Action="micvolume" ToolTip="{Binding MicGainLabel, StringFormat=Gain microfono: {0}}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="4,0">
                                <ToggleButton Content="🎧" IsChecked="{Binding DeckB.CueOn}" v:Shortcut.Action="b.cuepfl" Style="{StaticResource ToolToggle}" Padding="0" Width="28" Height="20" MinWidth="0" FontSize="10" Margin="0,2,0,6" ToolTip="Pre-ascolto in cuffia del deck B"/>
                                <Grid Height="190" Width="28">
                                    <v:LevelMeter Left="{Binding DeckB.LevelL}" Right="{Binding DeckB.LevelR}" Vertical="True" Width="12" Height="190" HorizontalAlignment="Center" ToolTip="Livello deck B (dopo trim e fader)"/>
                                    <Slider Minimum="0" Maximum="1" Value="{Binding DeckB.Fader}" Width="190" Height="28" Background="Transparent" v:Shortcut.Action="b.fader" Foreground="Transparent" ToolTip="Fader di canale B">
                                        <Slider.LayoutTransform><RotateTransform Angle="-90"/></Slider.LayoutTransform>
                                    </Slider>
                                </Grid>
                                <TextBlock Text="B" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource AccentBBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <v:Knob Label="TRIM" Value="{Binding DeckB.GainDb}" Minimum="-24" Maximum="12" Diameter="24" DefaultValue="0" Accent="{StaticResource AccentBBrush}" v:Shortcut.Action="b.volume" ToolTip="{Binding DeckB.GainLabel, StringFormat=Trim B: {0}}"/>
                                <v:Knob Label="HI" Value="{Binding DeckB.EqHigh}" Minimum="-12" Maximum="12" Diameter="24" Bipolar="True" Accent="{StaticResource AccentBBrush}" IsKilled="{Binding DeckB.EqHighKill}" v:Shortcut.Action="b.eqhigh" RightClick="KillHighB" ToolTip="EQ alti B · tasto destro = kill · doppio click = 0"/>
                                <v:Knob Label="MID" Value="{Binding DeckB.EqMid}" Minimum="-12" Maximum="12" Diameter="24" Bipolar="True" Accent="{StaticResource AccentBBrush}" IsKilled="{Binding DeckB.EqMidKill}" v:Shortcut.Action="b.eqmid" RightClick="KillMidB" ToolTip="EQ medi B · tasto destro = kill · doppio click = 0"/>
                                <v:Knob Label="LOW" Value="{Binding DeckB.EqLow}" Minimum="-12" Maximum="12" Diameter="24" Bipolar="True" Accent="{StaticResource AccentBBrush}" IsKilled="{Binding DeckB.EqLowKill}" v:Shortcut.Action="b.eqlow" RightClick="KillLowB" ToolTip="EQ bassi B · tasto destro = kill · doppio click = 0"/>
                                <v:Knob Label="FILTER" Value="{Binding DeckB.FilterValue}" Minimum="-1" Maximum="1" Diameter="24" Bipolar="True" Accent="{StaticResource WarnBrush}" v:Shortcut.Action="b.filtervalue" ToolTip="Filtro B: sinistra low-pass, destra high-pass (doppio click = off)"/>
                                <v:Knob Label="PAN" Value="{Binding DeckB.Pan}" Minimum="-1" Maximum="1" Diameter="24" Bipolar="True" Accent="{StaticResource TextBrush}" v:Shortcut.Action="b.pan" ToolTip="{Binding DeckB.PanLabel, StringFormat=Pan B: {0}}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="A" Width="34" Height="34" Padding="0" FontWeight="SemiBold" Foreground="{StaticResource AccentABrush}" v:Shortcut.Action="fadeA"
                                    Command="{Binding CrossfadeToACommand}" ToolTip="Sfuma verso A"/>
                            <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Crossfader}" VerticalAlignment="Center" Margin="6,0"/>
                            <Button Grid.Column="2" Content="B" Width="34" Height="34" Padding="0" FontWeight="SemiBold" Foreground="{StaticResource AccentBBrush}" v:Shortcut.Action="fadeB"
                                    Command="{Binding CrossfadeToBCommand}" ToolTip="Sfuma verso B"/>
                        </Grid>
                    </StackPanel>

                </Grid>
            </Border>

            <v:DeckControl Grid.Column="2" DataContext="{Binding DeckB}" Accent="{StaticResource AccentBBrush}"/>
        </Grid>

        <!-- ═══════════ libreria + coda ═══════════ -->

        <!-- ═══════════ barra LIVE: automix, microfono, cuffia, riempimento (sotto i deck, come i comandi di un mixer) ═══════════ -->
        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Quando l'auto-mix è acceso tutta la sezione si illumina: dal vivo, a due metri dal portatile,
                     si deve capire in un colpo d'occhio chi sta comandando la serata, e fermarlo con un tasto solo. -->
                <Border Grid.Column="0" CornerRadius="3" Padding="8,5" Margin="-4,-3,6,-3" BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutoMix}" Value="True">
                                    <Setter Property="Background" Value="#1F8A2BFF"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AutoMixHold}" Value="True">
                                    <Setter Property="Background" Value="#1FF2A33C"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                <StackPanel>
                    <!-- tutto su una riga sola: nella barra LIVE lo spazio in orizzontale c'è, e in serata si guarda una riga sola -->
                    <DockPanel>
                        <TextBlock Text="AUTO-MIX" Style="{StaticResource SectionTitle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AutoMixStateLabel}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="48">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutoMix}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding AutoMixHold}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ToggleButton Content="⏸ PAUSA" IsChecked="{Binding AutoMixHold}" Style="{StaticResource ToolToggle}" Height="24" Padding="8,0" FontSize="10.5" MinWidth="0" Margin="0,0,4,0"
                                      IsEnabled="{Binding AutoMix}" ToolTip="Finisce il brano in corso e si ferma lì, senza perdere le impostazioni. Ripremi per riprendere."/>
                        <Button Content="⏹ STOP" Command="{Binding AutoMixStopCommand}" Style="{StaticResource SmallButton}" Height="24" Padding="8,0" FontSize="10.5" Margin="0,0,4,0"
                                ToolTip="Ferma subito: annulla il passaggio in corso e spegne l'auto-mix"/>
                        <Button Content="⏭ MIXA ORA" Command="{Binding PlayNextCommand}" Style="{StaticResource SmallButton}" Height="24" Padding="8,0" FontSize="10.5" Margin="0,0,14,0"
                                ToolTip="Fa partire subito il passaggio al prossimo in coda (Ctrl+N)"/>
                        <CheckBox IsChecked="{Binding AutoMix}" Content="dalla coda" v:Shortcut.Action="automix" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="A fine brano parte automaticamente il prossimo in coda con il passaggio da DJ"/>
                        <CheckBox IsChecked="{Binding AutoMixEndless}" Content="mai fermarsi" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Coda vuota → il prossimo brano viene preso dai suggeriti (stesso genere, non ancora suonato stasera)"/>
                        <CheckBox IsChecked="{Binding BpmMatch}" Content="aggancia BPM" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="Il brano entrante viene portato ai BPM di quello in uscita (×1, ×2 o ×½, max ±25 %)"/>
                        <TextBlock Text="Generi serata" Style="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Quando l'automix sceglie da solo pesca solo in questi generi. Vuoto = segue il genere del brano in corso."/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MixStatus}" Style="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding SetGenres, UpdateSourceTrigger=LostFocus}" FontSize="11" Padding="6,2" MinWidth="120" MaxWidth="240" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 ToolTip="Generi separati da virgola, come nei tag (es. Dance, House, Pop italiano)"/>
                    </DockPanel>
                    <Expander Margin="0,4,0,0" IsExpanded="False" Foreground="{StaticResource MutedBrush}">
                                    <Expander.Header><TextBlock Text="Avanzate" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/></Expander.Header>
                                    <StackPanel Margin="0,4,0,0">
                                        <CheckBox IsChecked="{Binding AutoMixUseCues}" Content="Usa intro/uscita rilevate" Margin="0,3" ToolTip="Mixa all'inizio dell'uscita e fa partire il brano successivo dopo l'intro (serve l'analisi del brano)"/>
                                        <DockPanel Margin="0,3">
                                            <CheckBox IsChecked="{Binding BpmLock}" Content="Blocca BPM a" ToolTip="Tutti i brani caricati vengono velocizzati/rallentati a questo tempo"/>
                                            <TextBox Text="{Binding BpmLockValue, StringFormat={}{0:0}, UpdateSourceTrigger=LostFocus}" Width="60" Margin="6,0,0,0" TextAlignment="Center" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="Passaggio" Width="80" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11"/>
                                            <ComboBox SelectedValue="{Binding TransitionStyle}" SelectedValuePath="Tag" FontSize="11" Padding="6,2"
                                                      ToolTip="Come viene fatto il passaggio automatico tra i due brani">
                                                <ComboBoxItem Tag="auto" Content="Automatico (varia: blend, bassi, filtro, echo, taglio)"/>
                                                <ComboBoxItem Tag="blend" Content="Blend lungo (16 battute, EQ incrociato)"/>
                                                <ComboBoxItem Tag="bass" Content="Scambio bassi (16 battute)"/>
                                                <ComboBoxItem Tag="filter" Content="Filtro (8 battute: HP in uscita, LP in entrata)"/>
                                                <ComboBoxItem Tag="echo" Content="Echo-out (4 battute, il nuovo entra sull'1)"/>
                                                <ComboBoxItem Tag="cut" Content="Taglio sull'1 (2 battute)"/>
                                                <ComboBoxItem Tag="brake" Content="Brake + partenza sull'1"/>
                                                <ComboBoxItem Tag="fade" Content="Dissolvenza semplice (senza beat)"/>
                                            </ComboBox>
                                        </DockPanel>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="Dissolvenza" Width="80" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CrossfadeSeconds, StringFormat={}{0:0} s}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <Slider Minimum="1" Maximum="15" Value="{Binding CrossfadeSeconds}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Expander>
                </StackPanel>
                </Border>
                <!-- microfono: on, talk-over, meter; la sezione EQ/effetti si apre col tasto EQ -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="MIC" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ToggleButton Content="🎤" v:Shortcut.Action="mic" Style="{StaticResource ToolToggle}" IsChecked="{Binding MicOn}" Padding="6,0" Height="26" MinWidth="30" FontSize="12" Margin="0,0,3,0" ToolTip="Microfono on/off (ingresso in Impostazioni → Audio; il gain è la manopola MIC nel mixer)"/>
                    <ToggleButton Content="TALK" v:Shortcut.Action="talk" Style="{StaticResource ToolToggle}" IsChecked="{Binding TalkOver}" Padding="8,0" Height="26" MinWidth="30" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,3,0"
                                  PreviewMouseLeftButtonDown="Talk_Down" PreviewMouseLeftButtonUp="Talk_Up" ToolTip="Talk-over: tieni premuto per parlare sopra la musica (i deck si abbassano)"/>
                    <v:LevelMeter Left="{Binding MicLevel}" Right="{Binding MicLevel}" Height="6" Width="44" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding MicOn, Converter={StaticResource BoolToVis}}"/>
                    <ToggleButton Content="EQ / FX" IsChecked="{Binding MicEqVisible}" Style="{StaticResource ToolToggle}" Padding="8,0" Height="26" MinWidth="30" FontSize="10.5" Margin="0,0,3,0" ToolTip="Apre/chiude equalizzatore ed effetti del microfono"/>
                    <!-- applausometro: ascolta dal microfono e mette il punteggio sul proiettore -->
                    <Button Content="👏" Command="{Binding StartApplauseCommand}" v:Shortcut.Action="applause" Style="{StaticResource SmallButton}" Padding="8,0" Height="26" MinWidth="30" FontSize="13" Margin="0,0,3,0"
                            ToolTip="Applausometro: sette secondi di applausi misurati dal microfono, con punteggio grande sul proiettore. Ripremi per toglierlo."/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding MicEqVisible, Converter={StaticResource BoolToVis}}" Margin="4,0,0,0">
                        <v:Knob Label="LOW" Value="{Binding MicEqLow}" Minimum="-12" Maximum="12" Bipolar="True" Diameter="24" Accent="{StaticResource TextBrush}" Margin="0,0,4,0" ToolTip="EQ bassi microfono"/>
                        <v:Knob Label="MID" Value="{Binding MicEqMid}" Minimum="-12" Maximum="12" Bipolar="True" Diameter="24" Accent="{StaticResource TextBrush}" Margin="0,0,4,0" ToolTip="EQ medi microfono"/>
                        <v:Knob Label="HI" Value="{Binding MicEqHigh}" Minimum="-12" Maximum="12" Bipolar="True" Diameter="24" Accent="{StaticResource TextBrush}" Margin="0,0,8,0" ToolTip="EQ alti microfono"/>
                        <ToggleButton Content="AUTO" IsChecked="{Binding MicAutoDuck}" Style="{StaticResource ToolToggle}" Padding="5,0" Height="22" MinWidth="0" FontSize="9.5" Margin="0,0,2,0" VerticalAlignment="Top" ToolTip="{Binding MicDuckLabel, StringFormat=Talk-over automatico: quando parli i deck scendono di {0}}"/>
                        <ToggleButton Content="ECO" IsChecked="{Binding MicEcho}" Style="{StaticResource ToolToggle}" Padding="5,0" Height="22" MinWidth="0" FontSize="9.5" Margin="0,0,2,0" VerticalAlignment="Top" ToolTip="Eco sulla voce"/>
                        <ToggleButton Content="RVB" IsChecked="{Binding MicReverb}" Style="{StaticResource ToolToggle}" Padding="5,0" Height="22" MinWidth="0" FontSize="9.5" Margin="0" VerticalAlignment="Top" ToolTip="Riverbero sulla voce"/>
                    </StackPanel>
                </StackPanel>
                <!-- cuffia · riempimento · rotazione -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding CueAvailable, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0">
                        <TextBlock Text="🎧" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Cuffia: cosa senti (CUE ↔ MASTER)"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding CueMix}" Width="70" VerticalAlignment="Center" v:Shortcut.Action="cuemix"/>
                        <TextBlock Text="{Binding CueMixLabel}" Width="44" Style="{StaticResource Muted}" FontSize="9.5" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <ToggleButton Content="⏯ RIEMPIMENTO" IsChecked="{Binding FillMusicOn}" v:Shortcut.Action="fill" Style="{StaticResource ToolToggle}" Padding="8,0" Height="26" FontSize="10.5" Margin="0,0,3,0"
                                  ToolTip="Musica di riempimento: quando una base finisce e nessuno canta parte un brano dalla playlist scelta; sfuma da solo appena avvii la prossima base"/>
                    <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding FillPlaylist}" DisplayMemberPath="Name" FontSize="10.5" MinWidth="90" Height="26" Margin="0,0,3,0"
                              Visibility="{Binding FillMusicOn, Converter={StaticResource BoolToVis}}" ToolTip="Playlist di riempimento (vuota = tutta la musica non karaoke)"/>
                    <ToggleButton Content="🔁 ROTAZIONE" IsChecked="{Binding RotationOn}" v:Shortcut.Action="rotation" Style="{StaticResource ToolToggle}" Padding="8,0" Height="26" FontSize="10.5" Margin="0,0,3,0"
                                  ToolTip="Rotazione equa dei cantanti: la coda si riordina a giri; chi ha già cantato aspetta chi non lo ha ancora fatto"/>
                    <!-- registrazione della serata: il mix com'è uscito, su file WAV -->
                    <ToggleButton IsChecked="{Binding Recording}" Command="{Binding ToggleRecordingCommand}" v:Shortcut.Action="record" Style="{StaticResource ToolToggle}" Padding="8,0" Height="26" FontSize="10.5" Margin="0,0,3,0"
                                  ToolTip="Registra la serata su file (in %AppData%\KaraokeDJ\registrazioni). Va avanti anche se fermi la musica: si ferma solo quando lo dici tu.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏺" Foreground="#FFE05252" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="REC" VerticalAlignment="Center" Visibility="{Binding Recording, Converter={StaticResource BoolToVisInv}}"/>
                            <TextBlock Text="{Binding RecordingStatus}" VerticalAlignment="Center" Visibility="{Binding Recording, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ToggleButton>
                    <!-- via di fuga: se la console manda da sola, la si isola con un tasto senza staccare il cavo -->
                    <ToggleButton Content="🎛 IGNORA CONSOLE" IsChecked="{Binding MidiMuted}" v:Shortcut.Action="midimute" Style="{StaticResource ToolToggle}" Padding="8,0" Height="26" FontSize="10.5" Margin="0,0,3,0"
                                  Visibility="{Binding ControllerConnected, Converter={StaticResource BoolToVis}}"
                                  ToolTip="La console resta collegata ma non comanda più niente: da usare se manda comandi da sola. Ripremi per riattivarla."/>
                    <!-- FERMA TUTTO: in serata deve esserci un tasto che riporta il silenzio, qualunque cosa stia succedendo -->
                    <Button Content="⛔ FERMA TUTTO" Command="{Binding PanicCommand}" v:Shortcut.Action="panic" Height="26" Padding="10,0" FontSize="10.5" FontWeight="SemiBold" Margin="0"
                            Foreground="White" Background="#C0392B" BorderBrush="#E74C3C"
                            ToolTip="Silenzio immediato (Esc): ferma i due deck, i pad, la batteria e il riempimento, annulla il passaggio in corso e spegne l'auto-mix. Da lì non riparte niente da solo."/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- libreria -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="LIBRERIA" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LibraryCount, StringFormat={}{0} brani}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <!-- filtri e opzioni: solo icone, descrizione al passaggio del mouse -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <RadioButton Style="{StaticResource Chip}" Content="📚" GroupName="LibFilter" IsChecked="True" Command="{Binding SetLibraryFilterCommand}" CommandParameter="all" ToolTip="Tutti&#10;Tutta la libreria."/>
                            <RadioButton Style="{StaticResource Chip}" Content="♪" GroupName="LibFilter" Command="{Binding SetLibraryFilterCommand}" CommandParameter="audio" ToolTip="Audio&#10;Solo brani musicali (senza testo)."/>
                            <RadioButton Style="{StaticResource Chip}" Content="🎤" GroupName="LibFilter" Command="{Binding SetLibraryFilterCommand}" CommandParameter="cdg" ToolTip="CDG&#10;Basi karaoke MP3+G."/>
                            <RadioButton Style="{StaticResource Chip}" Content="🎬" GroupName="LibFilter" Command="{Binding SetLibraryFilterCommand}" CommandParameter="video" ToolTip="Video&#10;Basi karaoke video."/>
                            <RadioButton Style="{StaticResource Chip}" Content="🎹" GroupName="LibFilter" Command="{Binding SetLibraryFilterCommand}" CommandParameter="midi" ToolTip="MIDI / KAR&#10;Basi MIDI sintetizzate con FluidSynth, testo sul proiettore. Mai nel mix automatico."/>
                            <RadioButton Style="{StaticResource Chip}" Content="🎯" GroupName="LibFilter" Command="{Binding RefreshCompatibilityCommand}"
                                         ToolTip="Compatibili&#10;Ordina per affinità (BPM ±8 %, tonalità Camelot vicina) con il brano in riproduzione o selezionato. Clicca di nuovo per aggiornare."/>
                            <RadioButton Style="{StaticResource Chip}" Content="🎼" GroupName="LibFilter" Command="{Binding SetLibraryFilterCommand}" CommandParameter="key"
                                         ToolTip="Tonalità compatibile&#10;Solo brani in tonalità armonicamente compatibile (ruota Camelot: stesso numero o ±1) con il deck che si sente. Con MATCH sul deck trasponi il brano entrante."/>
                            <ToggleButton Style="{StaticResource GenreChip}" IsChecked="{Binding HideCryptic}" Content="🙈" Margin="8,0,0,0" Padding="8,2" FontSize="12"
                                          ToolTip="Nascondi titoli senza senso&#10;File con nome incomprensibile (es. $RFXPGZ2 del Cestino, codici senza vocali). Acceso = nascosti."/>
                            <ToggleButton Style="{StaticResource GenreChip}" IsChecked="{Binding ShowDuplicates}" Margin="4,0,0,0" Padding="8,2" FontSize="12"
                                          ToolTip="Mostra doppioni&#10;I brani uguali (stesso artista e titolo, durata simile) si vedono una volta sola: la copia migliore. Acceso = vedi anche le altre copie.">
                                <TextBlock><Run Text="👥 "/><Run Text="{Binding HiddenDuplicates, Mode=OneWay}"/></TextBlock>
                            </ToggleButton>
                        </StackPanel>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="8,6" MinWidth="220"
                                 ToolTip="Cerca per artista o titolo, anche con refusi (Ctrl+F). Un numero cerca per BPM (es. 120), '8a' o 'Am' per tonalità."/>
                    </DockPanel>

                    <!-- raccolte rapide per genere: un click filtra per tag (più tag = unione), di nuovo per togliere -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,6" Visibility="{Binding GenreChips.Count, Converter={StaticResource NullToVis}}">
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding GenreChipsExpanded}" Padding="8,2" FontSize="11" Margin="6,0,0,4" VerticalAlignment="Top"
                                      ToolTip="Raccolte per genere&#10;Chiuso: una riga sola. Aperto: tutti i generi.">
                            <ToggleButton.Content>
                                <TextBlock Text="▾ altri"/>
                            </ToggleButton.Content>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource GenreChip}">
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="▴ meno"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Border ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="MaxHeight" Value="28"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GenreChipsExpanded}" Value="True"><Setter Property="MaxHeight" Value="400"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                    <ItemsControl ItemsSource="{Binding GenreChips}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsSelected}" Padding="9,2" FontSize="11" Margin="0,0,4,4" Style="{StaticResource GenreChip}"
                                              Command="{Binding DataContext.ToggleGenreFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                              ToolTip="{Binding Count, StringFormat={}{0} brani}">
                                    <TextBlock><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Count, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="10"/></TextBlock>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        </Border>
                    </DockPanel>
                    <!-- playlist interne -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock Text="PLAYLIST" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="▶ In coda" Style="{StaticResource SmallButton}" Command="{Binding PlaylistToQueueCommand}" Margin="4,0,0,0"
                                Visibility="{Binding IsPlaylistSelected, Converter={StaticResource BoolToVis}}" ToolTip="Mette tutta la playlist nella coda"/>
                        <Button DockPanel.Dock="Right" Content="🗑" Style="{StaticResource SmallButton}" Command="{Binding DeletePlaylistCommand}" Margin="4,0,0,0"
                                Visibility="{Binding IsPlaylistSelected, Converter={StaticResource BoolToVis}}" ToolTip="Elimina playlist"/>
                        <Button DockPanel.Dock="Right" Content="✎" Style="{StaticResource SmallButton}" Command="{Binding RenamePlaylistCommand}" Margin="4,0,0,0"
                                Visibility="{Binding IsPlaylistSelected, Converter={StaticResource BoolToVis}}" ToolTip="Rinomina"/>
                        <Button DockPanel.Dock="Right" Content="▼" Style="{StaticResource SmallButton}" Command="{Binding MoveInPlaylistCommand}" CommandParameter="down" Margin="2,0,0,0"
                                Visibility="{Binding IsPlaylistSelected, Converter={StaticResource BoolToVis}}"/>
                        <Button DockPanel.Dock="Right" Content="▲" Style="{StaticResource SmallButton}" Command="{Binding MoveInPlaylistCommand}" CommandParameter="up" Margin="4,0,0,0"
                                Visibility="{Binding IsPlaylistSelected, Converter={StaticResource BoolToVis}}"/>
                        <Button DockPanel.Dock="Right" Content="− Togli" Style="{StaticResource SmallButton}" Command="{Binding RemoveSelectedFromPlaylistCommand}" Margin="4,0,0,0"
                                Visibility="{Binding IsPlaylistSelected, Converter={StaticResource BoolToVis}}" ToolTip="Togli il brano selezionato dalla playlist"/>
                        <Button DockPanel.Dock="Right" Content="＋ Aggiungi" Style="{StaticResource SmallButton}" Command="{Binding AddSelectedToPlaylistCommand}" Margin="4,0,0,0"
                                Visibility="{Binding IsPlaylistSelected, Converter={StaticResource BoolToVis}}" ToolTip="Aggiungi il brano selezionato. Con una playlist selezionata, scrivendo nella ricerca vedi tutta la libreria: cerca, seleziona, Aggiungi."/>
                        <Button DockPanel.Dock="Right" Content="Nuova" Style="{StaticResource SmallButton}" Command="{Binding NewPlaylistCommand}" Margin="4,0,0,0"/>
                        <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}" DisplayMemberPath="Display" MinWidth="180"
                                  x:Name="PlaylistCombo"/>
                        <Button Content="Tutti i brani" Style="{StaticResource SmallButton}" Click="AllTracks_Click" Margin="4,0,0,0"
                                Visibility="{Binding IsPlaylistSelected, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>

                    <DataGrid Grid.Row="3" x:Name="LibraryGrid" ItemsSource="{Binding LibraryView}" SelectedItem="{Binding SelectedTrack}"
                              MouseDoubleClick="LibraryGrid_MouseDoubleClick" EnableRowVirtualization="True"
                              PreviewMouseLeftButtonDown="LibraryGrid_PreviewMouseDown" PreviewMouseMove="LibraryGrid_PreviewMouseMove"
                              AllowDrop="True" DragOver="LibraryGrid_DragOver" Drop="LibraryGrid_Drop"
                              ToolTip="Doppio click: in coda · trascina un brano sul deck A o B per caricarlo · sulla coda per accodarlo">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlayedThisSession}" Value="True">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="2*"/>
                            <DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="3*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding KindLabel}" Width="60"/>
                            <DataGridTextColumn Header="Durata" Binding="{Binding DurationLabel}" Width="66"/>
                            <DataGridTextColumn Header="BPM" Binding="{Binding BpmLabel}" Width="50"/>
                            <DataGridTextColumn Header="Tonalità" Binding="{Binding KeyLabel}" Width="86"/>
                            <DataGridTextColumn Header="Anno" Binding="{Binding YearLabel}" Width="52"/>
                            <DataGridTextColumn Header="Genere" Binding="{Binding Genre}" Width="90"/>
                            <DataGridTextColumn Header="Match" Binding="{Binding MatchLabel}" Width="62"/>
                            <DataGridTextColumn Header="Suonato" Binding="{Binding PlayedLabel}" Width="74"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Carica su Deck A" Command="{Binding LoadSelectedToACommand}"/>
                                <MenuItem Header="Carica su Deck B" Command="{Binding LoadSelectedToBCommand}"/>
                                <MenuItem Header="Aggiungi alla coda" Command="{Binding AddToQueueCommand}"/>
                                <MenuItem Header="⤒ In cima alla coda" Command="{Binding QueueToTopCommand}"/>
                                <MenuItem Header="⚡ Mixa ora" Command="{Binding MixNowCommand}" ToolTip="Lo carica sul deck libero e sfuma subito"/>
                                <MenuItem Header="Aggiungi alla playlist" ItemsSource="{Binding Playlists}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}"/>
                                            <Setter Property="Command" Value="{Binding DataContext.AddSelectedToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Analizza BPM / tonalità" Command="{Binding AnalyzeSelectedCommand}"/>
                                <MenuItem Header="Analizza tutti i brani mancanti" Command="{Binding AnalyzeMissingCommand}"/>
                                <MenuItem Header="Azzera i segni 'suonato stasera'" Command="{Binding ClearPlayedMarksCommand}"/>
                                <Separator/>
                                <MenuItem Header="🏷 Generi (tag)" ItemsSource="{Binding GenreOptions}" ToolTip="Un brano può avere più generi: spunta quelli che c'entrano">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Name}"/>
                                            <Setter Property="IsCheckable" Value="True"/>
                                            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneTime}"/>
                                            <Setter Property="StaysOpenOnClick" Value="True"/>
                                            <Setter Property="Command" Value="{Binding DataContext.ToggleGenreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <MenuItem Header="🏷 Generi: scrivi a mano…" Command="{Binding SetGenreCommand}" ToolTip="Più generi separati da ; o virgola (vuoto = nessuno). Salvati anche nel tag del file."/>
                                <MenuItem Header="📅 Anno…" Command="{Binding SetYearCommand}"/>
                                <Separator/>
                                <MenuItem Header="✎ Rinomina intelligente (brano selezionato)" Command="{Binding CleanSelectedTitleCommand}"/>
                                <MenuItem Header="✎ Rinomina intelligente (tutta la libreria)" Command="{Binding CleanAllTitlesCommand}"/>
                                <MenuItem Header="🤖 Prepara base senza voce (Demucs)" Command="{Binding PrepareStemsSelectedCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- tag genere del brano selezionato: gestibili senza caricarlo su un deck (click sul tag = togli, + = aggiungi) -->
                    <DockPanel Grid.Row="4" Margin="0,6,0,0" Visibility="{Binding SelectedTrack, Converter={StaticResource NullToVis}}">
                        <TextBlock DockPanel.Dock="Left" Text="🏷" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Generi del brano selezionato"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedTrack.Display}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                        <Button DockPanel.Dock="Right" Content="＋ tag" Style="{StaticResource SmallButton}" Padding="7,1" FontSize="10" Click="SelectedAddTag_Click" ToolTip="Aggiungi un genere al brano selezionato (max 5)"/>
                        <ItemsControl ItemsSource="{Binding SelectedTrackGenres}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SmallButton}" Padding="7,1" FontSize="10" Margin="0,0,4,0" Foreground="{StaticResource AccentBrush}"
                                            Command="{Binding DataContext.ToggleGenreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            ToolTip="Click: togli questo genere dal brano">
                                        <TextBlock><Run Text="{Binding Mode=OneWay}"/><Run Text="  ✕" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="SingerBox" Text="{Binding SingerName, UpdateSourceTrigger=PropertyChanged}" FontSize="14"
                                 ToolTip="Nome del cantante (opzionale). Tasto destro: nomi già visti stasera e nelle serate passate (con la tonalità ricordata)." KeyDown="SingerBox_KeyDown" MouseRightButtonUp="SingerBox_Right">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Resources>
                                        <VisualBrush x:Key="Hint" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="  Nome cantante…" Foreground="{StaticResource MutedBrush}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource Hint}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0" ToolTip="Tonalità iniziale per questo cantante">
                            <Button Content="−" Width="28" Padding="0" Click="QueueKeyDown_Click"/>
                            <TextBlock Text="{Binding QueueKeyLabel}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                            <Button Content="+" Width="28" Padding="0" Click="QueueKeyUp_Click"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="＋ Coda" Style="{StaticResource AccentButton}" Command="{Binding AddToQueueCommand}" v:Shortcut.Action="addqueue" Margin="0,0,6,0" ToolTip="Ctrl+Invio. Tasto destro sul brano: in cima alla coda / mixa ora"/>
                        <Button Grid.Column="3" Content="→ A" Command="{Binding LoadSelectedToACommand}" Foreground="{StaticResource AccentABrush}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <Button Grid.Column="4" Content="→ B" Command="{Binding LoadSelectedToBCommand}" Foreground="{StaticResource AccentBBrush}" FontWeight="SemiBold"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- coda -->
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock Text="CODA CANTANTI" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Queue.Count, StringFormat={} ({0})}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,6"/>
                        <Button DockPanel.Dock="Right" Content="Svuota" Style="{StaticResource SmallButton}" Command="{Binding ClearQueueCommand}" HorizontalAlignment="Right"/>
                        <Button DockPanel.Dock="Right" Content="📲" Style="{StaticResource ToolIcon}" Command="{Binding ShowPublicQrCommand}" Margin="0,0,6,0"
                                ToolTip="Prenotazioni dal pubblico&#10;Mostra sul proiettore il QR della pagina dove il pubblico cerca un brano e si prenota (nome + dedica). Le richieste arrivano qui sopra la coda: accetti o scarti."/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Requests}" Visibility="{Binding HasRequests, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3300E5FF" CornerRadius="3" Padding="6,3" Margin="0,0,0,3">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallButton}" Padding="6,0" Command="{Binding DataContext.RejectRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Scarta"/>
                                        <Button DockPanel.Dock="Right" Content="✓ In coda" Style="{StaticResource SmallButton}" Padding="6,0" Margin="0,0,4,0" Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Accetta: va in coda col nome del cantante (e la dedica sul proiettore)"/>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="QueueList" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueEntry}"
                             HorizontalContentAlignment="Stretch" MouseDoubleClick="QueueList_MouseDoubleClick" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseMove="QueueList_PreviewMouseMove" Drop="QueueList_Drop" DragOver="QueueList_DragOver">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:QueueEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Track.KindLabel}" Style="{StaticResource Muted}" Width="40" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Singer}" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"
                                                   Visibility="{Binding Singer, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="{Binding Track.Display}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding KeyLabel}" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" Margin="6,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Content="⚡" Style="{StaticResource SmallButton}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" ToolTip="Mixa ora"
                                                Command="{Binding DataContext.QueueEntryMixNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0"/>
                                        <Button Content="⤒" Style="{StaticResource SmallButton}" ToolTip="In cima alla coda"
                                                Command="{Binding DataContext.QueueEntryToTopCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0"/>
                                        <Button Content="A" Style="{StaticResource SmallButton}" Foreground="{StaticResource AccentABrush}" FontWeight="SemiBold"
                                                Command="{Binding DataContext.QueueEntryToACommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0"/>
                                        <Button Content="B" Style="{StaticResource SmallButton}" Foreground="{StaticResource AccentBBrush}" FontWeight="SemiBold"
                                                Command="{Binding DataContext.QueueEntryToBCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0"/>
                                        <Button Content="✕" Style="{StaticResource SmallButton}"
                                                Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="▲" Style="{StaticResource SmallButton}" Command="{Binding MoveQueueUpCommand}" Margin="0,0,4,0"/>
                        <Button Content="▼" Style="{StaticResource SmallButton}" Command="{Binding MoveQueueDownCommand}" Margin="0,0,4,0"/>
                        <Button Content="Carica il primo sul deck libero" Style="{StaticResource SmallButton}" Command="{Binding LoadNextToFreeDeckCommand}"/>
                    </StackPanel>

                    <!-- suggeritore prossimo brano -->
                    <Border Grid.Row="3" Background="{StaticResource InnerPanelBrush}" CornerRadius="3" Padding="8,6" Margin="0,8,0,0" MaxHeight="290">
                        <DockPanel>
                            <!-- fuori libreria: proposte AI da scaricare e mettere in coda -->
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="{Binding ExternalSuggestionsLabel, Converter={StaticResource NullToVis}}">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding ExternalSuggestionsLabel}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding ExternalSuggestions}" MaxHeight="96">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <TextBlock Text="🌐" Width="24" VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" Content="👎" Style="{StaticResource SmallButton}" Padding="5,1" FontSize="11" Margin="2,0" ToolTip="Fuori target: non verrà più proposto"
                                                        Command="{Binding DataContext.ExternalSuggestionRejectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button DockPanel.Dock="Right" Content="⬇ prossimo" Style="{StaticResource SmallButton}" Padding="6,1" FontSize="11" Margin="2,0" ToolTip="Scarica e metti in cima alla coda"
                                                        Command="{Binding DataContext.DownloadSuggestionNextCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"/>
                                                <Button DockPanel.Dock="Right" Content="⬇ in coda" Style="{StaticResource SmallButton}" Padding="6,1" FontSize="11" Margin="2,0" ToolTip="Scarica (YouTube) e metti in coda"
                                                        Command="{Binding DataContext.DownloadSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Reason}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock Text="🎯 SUGGERITI" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="↻" Style="{StaticResource SmallButton}" Padding="6,1" Command="{Binding RefreshSuggestionsCommand}" ToolTip="Aggiorna"/>
                                <Button DockPanel.Dock="Right" Content="{Binding FlowIntentLabel}" Style="{StaticResource SmallButton}" Padding="8,1" Margin="0,0,6,0" MinWidth="64"
                                        Command="{Binding CycleFlowIntentCommand}"
                                        ToolTip="Dove vuoi portare la serata col prossimo brano: auto → ▲ alza → = tieni → ▼ calma.&#10;I suggeriti seguono l'energia e l'umore di conseguenza."/>
                                <Button DockPanel.Dock="Right" Content="🌐 Fuori libreria" Style="{StaticResource SmallButton}" Padding="6,1" Margin="0,0,6,0" Command="{Binding SuggestExternalCommand}"
                                        IsEnabled="{Binding IsSuggestingExternal, Converter={StaticResource InverseBool}}"
                                        ToolTip="Chiede all'AI brani NON in libreria adatti a seguire quello in corso: con un click li scarichi (YouTube) e li metti in coda. Serve la chiave API Anthropic."/>
                                <ComboBox DockPanel.Dock="Right" SelectedValue="{Binding SuggestBy}" SelectedValuePath="Tag" FontSize="11" Padding="6,1" MinWidth="112" Margin="6,0"
                                          ToolTip="Coerenza dei suggerimenti (vale anche per il filtro Compatibili)">
                                    <ComboBoxItem Tag="" Content="Mix libero"/>
                                    <ComboBoxItem Tag="decade" Content="Stessa decade"/>
                                    <ComboBoxItem Tag="genre" Content="Stesso genere"/>
                                </ComboBox>
                                <TextBlock Text="{Binding SuggestionsLabel}" Style="{StaticResource Muted}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:Track}">
                                        <DockPanel Margin="0,1">
                                            <TextBlock Text="{Binding MatchLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Width="38" VerticalAlignment="Center"
                                                       ToolTip="{Binding MatchWhy}"/>
                                            <Button DockPanel.Dock="Right" Content="→ deck" Style="{StaticResource SmallButton}" Padding="6,1" FontSize="11" Margin="2,0"
                                                    Command="{Binding DataContext.SuggestionToFreeDeckCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button DockPanel.Dock="Right" Content="👎" Style="{StaticResource SmallButton}" Padding="5,1" FontSize="11" Margin="2,0" ToolTip="Non c'entra: lo tolgo dai suggeriti di stasera e il suggeritore impara (soprattutto dopo questo brano)"
                                                    Command="{Binding DataContext.SuggestionRejectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button DockPanel.Dock="Right" Content="👍" Style="{StaticResource SmallButton}" Padding="5,1" FontSize="11" Margin="2,0" ToolTip="Abbinamento perfetto: lo rinforzo"
                                                    Command="{Binding DataContext.SuggestionApproveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button DockPanel.Dock="Right" Content="⚡ mix" Style="{StaticResource SmallButton}" Padding="6,1" FontSize="11" Margin="2,0" ToolTip="Mixa ora"
                                                    Command="{Binding DataContext.MixNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <Button DockPanel.Dock="Right" Content="＋ coda" Style="{StaticResource SmallButton}" Padding="6,1" FontSize="11" Margin="2,0"
                                                    Command="{Binding DataContext.SuggestionToQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding KeyLabel}" Style="{StaticResource Muted}" Width="60" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBlock Text="{Binding BpmLabel}" Style="{StaticResource Muted}" Width="28" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Decade}" Style="{StaticResource Muted}" Width="40" VerticalAlignment="Center" ToolTip="{Binding Genre}"/>
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ pad + download ═══════════ -->
        <Grid Grid.Row="5" Margin="0,0,0,8" Visibility="{Binding BottomStripVisible, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="JINGLE / EFFETTI  (F1–F12)" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ToggleButton IsChecked="{Binding IsEditingPads}" Content="✎ Assegna file" Padding="8,3" Margin="0,0,6,0"
                                          ToolTip="Attivo: cliccando un pad scegli il file. Puoi anche trascinare un file sul pad."/>
                            <Button Content="⏹ Stop tutti" Style="{StaticResource SmallButton}" Command="{Binding StopAllPadsCommand}"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Pads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:PadItem}">
                                <Button Margin="2" Height="34" Padding="2" AllowDrop="True" Drop="Pad_Drop" DragOver="Pad_DragOver" v:Shortcut.Action="{Binding ActionId}"
                                        Command="{Binding DataContext.TriggerPadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasFile}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Assegna file…" Command="{Binding PlacementTarget.Tag.AssignPadFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Svuota pad" Command="{Binding PlacementTarget.Tag.ClearPadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </Button.Tag>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Hotkey}" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="120"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="IMPORTA BRANI" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ImportSources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" MinWidth="200" FontSize="11" Padding="6,2"
                                  ToolTip="{Binding SelectedSource.Description}"/>
                        <TextBlock Text="da" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,6,0" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1">
                        <Button DockPanel.Dock="Right" Content="⬇ Importa" Style="{StaticResource AccentButton}" Command="{Binding DownloadCommand}" Margin="6,0,0,0"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisInv}}"/>
                        <Button DockPanel.Dock="Right" Content="Annulla" Style="{StaticResource DangerButton}" Command="{Binding CancelDownloadCommand}" Margin="6,0,0,0"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="{Binding DownloadInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ImportHint}"
                                 KeyDown="DownloadBox_KeyDown"/>
                    </DockPanel>
                    <!-- il suggerimento prende lo spazio che resta e si accorcia: in un pannello orizzontale uscirebbe dalla finestra -->
                    <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="True">
                        <RadioButton DockPanel.Dock="Left" Content="Audio MP3" IsChecked="{Binding DownloadVideo, Converter={StaticResource InverseBool}}" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                        <RadioButton DockPanel.Dock="Left" Content="Video (karaoke con testo)" IsChecked="{Binding DownloadVideo}" Foreground="{StaticResource TextBrush}" IsEnabled="{Binding SelectedSource.SupportsVideo}"/>
                        <TextBlock Text="{Binding ImportHint}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" Margin="0,6,0,4"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding DownloadStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ stato ═══════════ -->
        <DockPanel Grid.Row="6">
            <ProgressBar DockPanel.Dock="Right" Width="160" Height="8" Minimum="0" Maximum="100" Value="{Binding ScanPercent}"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Margin="10,0,0,0"/>
            <TextBlock Text="{Binding NowSinging, StringFormat=🎤 {0}}" DockPanel.Dock="Right" Foreground="{StaticResource WarnBrush}" Margin="10,0,0,0"
                       Visibility="{Binding NowSinging, Converter={StaticResource NullToVis}}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding AiStatus}" Foreground="{StaticResource MagentaBrush}" Margin="10,0,0,0" Visibility="{Binding AiStatus, Converter={StaticResource NullToVis}}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding AnalyzeStatus}" Style="{StaticResource Muted}" Margin="10,0,0,0" Visibility="{Binding AnalyzeStatus, Converter={StaticResource NullToVis}}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding UiScaleLabel}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"
                       ToolTip="Dimensione dell'interfaccia: Ctrl + ingrandisce, Ctrl − rimpicciolisce, Ctrl 0 torna automatica (Impostazioni → Generale)"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
