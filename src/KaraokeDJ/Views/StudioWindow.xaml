<Window x:Class="KaraokeDJ.Views.StudioWindow" FontFamily="{StaticResource UiFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:KaraokeDJ.Views"
        Title="{Binding Title}" Width="1600" Height="900" MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource WindowBgBrush}">
    <Window.Resources>
        <Style x:Key="Tb" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="Fx" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <!-- linguette leggibili sul tema scuro (quelle di Windows restavano bianche su bianco) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Padding="14,6" Margin="0,0,4,0" CornerRadius="4,4,0,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- barra in alto: progetto, trasporto, griglia, esportazione -->
        <Border Style="{StaticResource Panel}" Padding="10,8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <Button Content="📄 Nuovo" Style="{StaticResource Tb}" Command="{Binding NewMixCommand}" ToolTip="Nuovo mix (quello di adesso resta salvato)"/>
                <Button Content="📂 Apri" Style="{StaticResource Tb}" Click="Open_Click"/>
                <Button Content="💾 Salva come…" Style="{StaticResource Tb}" Click="SaveAs_Click" ToolTip="Il mix si salva da solo a ogni modifica; qui lo copi dove vuoi"/>
                <TextBox x:Name="NameBox" Width="220" FontSize="14" Padding="6,3" Margin="6,0,14,0" VerticalContentAlignment="Center" LostFocus="NameBox_LostFocus" KeyDown="NameBox_KeyDown"
                         ToolTip="Nome del mix (anche nome del file)"/>
                <Button x:Name="PlayBtn" Content="▶" Style="{StaticResource AccentButton}" Width="54" FontSize="16" Command="{Binding TogglePlayCommand}" ToolTip="Suona / ferma (Spazio)" Margin="0,0,6,0"/>
                <Button Content="⏮" Style="{StaticResource Tb}" Click="Home_Click" ToolTip="All'inizio (Home)"/>
                <TextBlock x:Name="PosText" FontFamily="Consolas" FontSize="18" VerticalAlignment="Center" Margin="6,0,14,0" Foreground="{StaticResource TextBrush}" Text="0:00.0"/>
                <ToggleButton IsChecked="{Binding OnMaster}" Padding="10,4" Margin="0,0,14,0"
                              ToolTip="Dove si sente lo Studio: in cuffia (in serata, senza disturbare la sala) o in sala (a casa, senza cuffia configurata)">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
                            <Setter Property="Content" Value="🎧 in cuffia"/>
                            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="🔊 in sala"/></Trigger></Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <TextBlock Text="BPM" Style="{StaticResource Lbl}"/>
                <TextBox Text="{Binding ProjectBpm, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Width="58" FontSize="13" Padding="4,3" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,14,0"
                         ToolTip="Tempo del progetto: la griglia, e il tempo a cui vanno le clip «a tempo» (entro ±12 %)"/>
                <TextBlock Text="Aggancio" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="SnapBox" Width="104" FontSize="12" SelectionChanged="Snap_Changed" Margin="0,0,14,0" ToolTip="Spostamenti e tagli si agganciano a battute o battiti (tieni premuto Alt per muovere libero)">
                    <ComboBoxItem Tag="bar" Content="Battuta" IsSelected="True"/>
                    <ComboBoxItem Tag="beat" Content="Battito"/>
                    <ComboBoxItem Tag="off" Content="Libero"/>
                </ComboBox>
                <Button Content="⤢ Adatta" Style="{StaticResource Tb}" Click="Fit_Click" ToolTip="Tutto il mix nella finestra (Ctrl+rotella per lo zoom)"/>
                <Button Content="↶" Style="{StaticResource Tb}" Command="{Binding UndoCommand}" ToolTip="Annulla (Ctrl+Z)"/>
                <Button Content="↷" Style="{StaticResource Tb}" Command="{Binding RedoCommand}" ToolTip="Ripeti (Ctrl+Y)"/>
                <Button DockPanel.Dock="Right" Content="⬇ Esporta" Style="{StaticResource AccentButton}" Padding="16,4" FontSize="13" Click="Export_Click"
                        ToolTip="Un file unico (mp3 320 kbit/s e wav) con la scaletta accanto" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <!-- timeline + strumenti sotto -->
            <DockPanel Margin="0,0,8,0">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Padding="10,8" Margin="0,8,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="CURVA" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Params}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AutomationParam}" Width="260" FontSize="12" Margin="0,0,10,0"/>
                            <TextBlock Style="{StaticResource Lbl}" TextWrapping="Wrap"
                                       Text="Sulla clip selezionata: Ctrl+clic aggiunge un punto, trascinalo per spostarlo, tasto destro lo toglie. Doppio clic fa partire da lì."/>
                        </DockPanel>
                        <WrapPanel>
                            <TextBlock Text="EFFETTI" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip="Dalla testina per 16 battiti, sulla clip selezionata"/>
                            <Button Content="Filtro ↑" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="filtro su" ToolTip="Passa-alto che sale: il brano si svuota verso l'alto"/>
                            <Button Content="Filtro ↓" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="filtro giù" ToolTip="Passa-basso che chiude: il brano diventa ovattato"/>
                            <Button Content="Filtro apre" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="filtro apre" ToolTip="Da ovattato a pieno (entrata)"/>
                            <Button Content="Echo out" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="echo out"/>
                            <Button Content="Gate" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="gate" ToolTip="Il suono si spezza a tempo"/>
                            <Button Content="Flanger" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="flanger"/>
                            <Button Content="Riverbero" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="riverbero"/>
                            <Button Content="Senza bassi" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="senza bassi"/>
                            <Button Content="Build-up" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="build" ToolTip="Gate che si stringe e filtro che sale: la tensione prima del drop"/>
                            <Button Content="✕ effetti" Style="{StaticResource Fx}" Command="{Binding QuickFxCommand}" CommandParameter="clear" ToolTip="Toglie tutte le curve dalla clip"/>
                            <TextBlock Text="LOOP" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="14,0,8,4" ToolTip="Sulla testina, agganciato alla battuta"/>
                            <Button Content="1 batt ×2" Style="{StaticResource Fx}" Command="{Binding AddLoopCommand}" CommandParameter="1b2"/>
                            <Button Content="1 batt ×4" Style="{StaticResource Fx}" Command="{Binding AddLoopCommand}" CommandParameter="1b4"/>
                            <Button Content="2 batt ×2" Style="{StaticResource Fx}" Command="{Binding AddLoopCommand}" CommandParameter="2b2"/>
                            <Button Content="4 batt ×2" Style="{StaticResource Fx}" Command="{Binding AddLoopCommand}" CommandParameter="4b2"/>
                            <Button Content="Roll ½" Style="{StaticResource Fx}" Command="{Binding AddLoopCommand}" CommandParameter="r2" ToolTip="Mezzo battito ripetuto 8 volte"/>
                            <Button Content="Roll ¼" Style="{StaticResource Fx}" Command="{Binding AddLoopCommand}" CommandParameter="r4" ToolTip="Un quarto di battito ripetuto 16 volte"/>
                            <Button Content="✕ loop" Style="{StaticResource Fx}" Command="{Binding ClearLoopsCommand}"/>
                            <TextBlock Text="CLIP" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="14,0,8,4"/>
                            <Button Content="✂ Taglia qui" Style="{StaticResource Fx}" Command="{Binding SplitClipCommand}" ToolTip="Divide la clip sulla testina (S)"/>
                            <Button Content="⧉ Duplica" Style="{StaticResource Fx}" Command="{Binding DuplicateClipCommand}" ToolTip="Ctrl+D"/>
                            <Button Content="🗑 Togli" Style="{StaticResource Fx}" Command="{Binding DeleteClipCommand}" ToolTip="Canc"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <v:StudioTimeline x:Name="Timeline"/>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="Playhead" Width="2" Fill="#FFFF4D6D" Height="2000" Canvas.Top="0"/>
                        </Canvas>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- colonna a destra -->
            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="10">
                <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Brani">
                        <DockPanel Margin="0,6,0,0">
                            <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,5"
                                     ToolTip="Cerca in libreria. Trascina un brano sulla timeline per metterlo in un punto preciso."/>
                            <!-- assistente -->
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource InnerPanelBrush}" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="ASSISTENTE MIX DA DJ" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6"
                                               Text="Scaletta nell'ordine voluto: l'assistente mette i brani su Deck A e B, sceglie punti di attacco e passaggi. Poi ritocchi tutto a mano."/>
                                    <ListBox x:Name="SetlistBox" ItemsSource="{Binding Setlist}" Height="150" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallButton}" Padding="5,0" Command="{Binding DataContext.SetlistRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    <Button DockPanel.Dock="Right" Content="▼" Style="{StaticResource SmallButton}" Padding="5,0" Margin="2,0" Command="{Binding DataContext.SetlistDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    <Button DockPanel.Dock="Right" Content="▲" Style="{StaticResource SmallButton}" Padding="5,0" Command="{Binding DataContext.SetlistUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Bpm, StringFormat={}{0:0}}" Style="{StaticResource Muted}" Margin="6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="＋ dalla coda" Style="{StaticResource Fx}" Command="{Binding SetlistFromQueueCommand}" ToolTip="Aggiunge i brani della coda della serata"/>
                                        <Button Content="Svuota" Style="{StaticResource Fx}" Command="{Binding SetlistClearCommand}"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <RadioButton Content="Brani interi" IsChecked="{Binding BuildSnippets, Converter={StaticResource InverseBool}}" Margin="0,0,12,4" VerticalAlignment="Center"/>
                                        <RadioButton Content="Spezzoni (ritornello)" IsChecked="{Binding BuildSnippets}" Margin="0,0,6,4" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SnippetSec, UpdateSourceTrigger=LostFocus}" Width="36" Padding="2" TextAlignment="Center" IsEnabled="{Binding BuildSnippets}" ToolTip="Secondi per spezzone"/>
                                        <TextBlock Text=" s" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="Passaggi" Style="{StaticResource Lbl}"/>
                                        <ComboBox ItemsSource="{Binding BuildTransitions}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding BuildTransition}" FontSize="12"/>
                                    </DockPanel>
                                    <Button Content="✨ Crea il mix" Style="{StaticResource AccentButton}" Margin="0,8,0,0" Padding="10,6" FontSize="13" Command="{Binding BuildMixCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="Sostituisce i brani sulle corsie Deck A/B (voce ed effetti restano). Si può annullare."/>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="ResultsBox" ItemsSource="{Binding Results}" Margin="0,6,0,0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonDown="Results_MouseDown" PreviewMouseMove="Results_MouseMove" MouseDoubleClick="Results_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="→ scaletta" Style="{StaticResource SmallButton}" Padding="5,0" FontSize="11" Command="{Binding DataContext.SetlistAddCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Nella scaletta dell'assistente"/>
                                            <Button DockPanel.Dock="Right" Content="＋ mix" Style="{StaticResource SmallButton}" Padding="5,0" FontSize="11" Margin="0,0,3,0" Command="{Binding DataContext.AddToEndCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="In fondo al mix, con un passaggio automatico (doppio clic)"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="10.5">
                                                    <Run Text="{Binding Bpm, StringFormat={}{0:0} BPM, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding KeyLabel, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Genre, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Clip">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Seleziona una clip sulla timeline" Style="{StaticResource Muted}" Visibility="{Binding HasClip, Converter={StaticResource BoolToVisInv}}"/>
                                <StackPanel Visibility="{Binding HasClip, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ClipTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ClipInfo}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="TEMPO E TONALITÀ" Style="{StaticResource Head}"/>
                                    <CheckBox Content="A tempo col progetto (entro ±12 %)" IsChecked="{Binding ClipWarp}" Margin="0,0,0,6"/>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Velocità %" Style="{StaticResource Lbl}" Width="80"/>
                                        <TextBox Text="{Binding ClipTempoPct, UpdateSourceTrigger=LostFocus}" Width="70" Padding="3" TextAlignment="Center" HorizontalAlignment="Left" ToolTip="Senza cambiare l'intonazione"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Tonalità" Style="{StaticResource Lbl}" Width="80"/>
                                        <TextBox Text="{Binding ClipKey, UpdateSourceTrigger=LostFocus}" Width="70" Padding="3" TextAlignment="Center" HorizontalAlignment="Left" ToolTip="Semitoni, da −12 a +12 (per un medley nella stessa tonalità)"/>
                                    </DockPanel>
                                    <TextBlock Text="VOLUME" Style="{StaticResource Head}"/>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Guadagno dB" Style="{StaticResource Lbl}" Width="80"/>
                                        <TextBox Text="{Binding ClipGain, UpdateSourceTrigger=LostFocus}" Width="70" Padding="3" TextAlignment="Center" HorizontalAlignment="Left" ToolTip="In più rispetto al volume uniformato automaticamente"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Entrata s" Style="{StaticResource Lbl}" Width="80"/>
                                        <TextBox Text="{Binding ClipFadeIn, UpdateSourceTrigger=LostFocus}" Width="70" Padding="3" TextAlignment="Center" HorizontalAlignment="Left" ToolTip="Dissolvenza in entrata"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Uscita s" Style="{StaticResource Lbl}" Width="80"/>
                                        <TextBox Text="{Binding ClipFadeOut, UpdateSourceTrigger=LostFocus}" Width="70" Padding="3" TextAlignment="Center" HorizontalAlignment="Left" ToolTip="Dissolvenza in uscita"/>
                                    </DockPanel>
                                    <TextBlock Text="PEZZO DEL BRANO" Style="{StaticResource Head}"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" Text="Un clic tiene solo quella parte (i bordi della clip si trascinano anche a mano, agganciati alle battute)."/>
                                    <ItemsControl ItemsSource="{Binding ClipSections}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}" Style="{StaticResource SmallButton}" Padding="7,2" Margin="0,0,4,4" FontSize="11.5"
                                                        Command="{Binding DataContext.UseSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="LOOP" Style="{StaticResource Head}"/>
                                    <TextBlock Text="{Binding ClipLoopsLabel}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Passaggio">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="Clicca sulla fascia viola ⇄ fra due brani sulla timeline" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding HasTransition, Converter={StaticResource BoolToVisInv}}"/>
                            <StackPanel Visibility="{Binding HasTransition, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TransitionInfo}" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="TIPO" Style="{StaticResource Head}"/>
                                <ListBox ItemsSource="{Binding Presets}" SelectedValuePath="Id" SelectedValue="{Binding TransitionPreset}" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="Durata (battiti)" Style="{StaticResource Lbl}"/>
                                    <ComboBox ItemsSource="{Binding BeatChoices}" SelectedItem="{Binding TransitionBeats}" Width="80" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <Button Content="▶ Ascolta il passaggio" Style="{StaticResource AccentButton}" Margin="0,12,0,0" Padding="10,6" Command="{Binding ListenTransitionCommand}"
                                        ToolTip="8 secondi prima e 8 dopo"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="Il passaggio scrive le curve dei due brani (volume, bassi, filtro, echo…): scegli «Curva» sotto la timeline per vederle e ritoccarle. Cambiando tipo le curve della zona sovrapposta si riscrivono."/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- stato -->
        <DockPanel Grid.Row="2" Margin="2,8,2,0">
            <ProgressBar DockPanel.Dock="Right" Width="220" Height="8" Maximum="1" Value="{Binding BusyProgress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
