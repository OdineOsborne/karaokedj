<Window x:Class="KaraokeDJ.Views.RhythmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KaraokeDJ.ViewModels"
        Title="Ritmi · sequencer di supporto" Width="1060" Height="520" MinWidth="900" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBgBrush}">
    <Window.Resources>
        <Style x:Key="Step" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="5" Background="#FF1A1A22" BorderBrush="#FF2A2A36" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBeat}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF23232E"/>
                            </DataTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Current}" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource MagentaBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentABrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBeat}" Value="True">
                    <Setter Property="Margin" Value="7,0,1,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Content" Value="▶ AVVIA"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Content" Value="■ STOP"/>
                    <Setter Property="Background" Value="{StaticResource MagentaBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- trasporto e tempo -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Style="{StaticResource PlayBtn}" Command="{Binding TogglePlayCommand}" MinWidth="110"/>
            <Button Content="↺ dall'1" Command="{Binding ResyncCommand}" Margin="6,0,0,0" ToolTip="Riparte dal primo step: premilo sul battere del brano per allineare il ritmo"/>
            <Button Content="{Binding TapLabel}" Command="{Binding TapCommand}" Margin="14,0,0,0" MinWidth="96" FontWeight="Black"
                    ToolTip="Tap tempo: batti il tempo con un click (o con la barra spaziatrice); imposta i BPM manuali"/>
            <CheckBox IsChecked="{Binding FollowDecks}" Content="segue i deck" Margin="14,0,0,0" VerticalAlignment="Center"
                      ToolTip="Usa i BPM del deck in riproduzione (o del Blocca BPM). Spento: BPM manuali / tap"/>
            <Slider Minimum="60" Maximum="200" Value="{Binding ManualBpm}" Width="160" Margin="10,0,0,0" VerticalAlignment="Center"
                    IsEnabled="{Binding FollowDecks, Converter={StaticResource InverseBool}}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding BpmLabel, StringFormat={}{0} BPM}" FontFamily="Consolas" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="150"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="SWING" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Slider Minimum="0" Maximum="0.4" Value="{Binding Swing}" Width="80" Margin="6,0,14,0" VerticalAlignment="Center"/>
                <TextBlock Text="VOLUME" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Slider Minimum="0" Maximum="1.2" Value="{Binding Volume}" Width="120" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock/>
        </DockPanel>

        <!-- preset e tracce -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="PRESET" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ItemsControl x:Name="PresetBar" ItemsSource="{Binding PresetList}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Item2}" Style="{StaticResource SmallButton}" Padding="8,3" Margin="0,0,4,0"
                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Item1}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="✕ pulisci" Style="{StaticResource SmallButton}" Padding="8,3" Command="{Binding ClearAllCommand}" Margin="0,0,6,0" ToolTip="Toglie tutti i colpi"/>
                <Button Content="＋ traccia" Style="{StaticResource SmallButton}" Padding="8,3" Command="{Binding AddTrackCommand}" ToolTip="Aggiunge una traccia (suono del kit o campione tuo)"/>
            </StackPanel>
            <TextBlock/>
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RhythmTrackViewModel}">
                        <Border Background="#FF0D0D12" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="🗑" Style="{StaticResource SmallButton}" Padding="6,2" Command="{Binding RemoveCommand}" ToolTip="Rimuovi traccia" Margin="4,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallButton}" Padding="6,2" Command="{Binding ClearCommand}" ToolTip="Pulisci pattern" Margin="4,0,0,0"/>
                                <ToggleButton DockPanel.Dock="Right" Content="M" IsChecked="{Binding Muted}" Padding="8,2" FontSize="11" FontWeight="Black" ToolTip="Mute" Margin="8,0,0,0"/>
                                <Slider DockPanel.Dock="Right" Minimum="0" Maximum="1.2" Value="{Binding Volume}" Width="90" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Volume traccia"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="96" VerticalAlignment="Center" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding Sounds}" SelectedItem="{Binding Sound}" Width="104" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                <Button Content="📂" Style="{StaticResource SmallButton}" Padding="6,2" Command="{Binding PickSampleCommand}" Margin="4,0,0,0" ToolTip="{Binding SampleLabel}"/>
                                <Button Content="▶" Style="{StaticResource SmallButton}" Padding="7,2" Command="{Binding PreviewCommand}" Margin="4,0,10,0" ToolTip="Ascolta il suono"/>
                                <ItemsControl ItemsSource="{Binding Steps}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                            <ToggleButton Style="{StaticResource Step}" IsChecked="{Binding On}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Chiudi" IsCancel="True"/>
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Ogni riga è una traccia di supporto: 16 step = una battuta in 4/4. Click sugli step per accendere i colpi; il ritmo suona nel master sopra i deck e segue i BPM della serata. Spazio = tap tempo."/>
        </DockPanel>
    </Grid>
</Window>
