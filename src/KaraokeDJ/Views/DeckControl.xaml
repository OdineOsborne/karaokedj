<UserControl x:Class="KaraokeDJ.Views.DeckControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KaraokeDJ.Views"
             x:Name="Root">
    <Border Style="{StaticResource Panel}" BorderBrush="{Binding Accent, ElementName=Root}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="{Binding Accent.Color, ElementName=Root}" BlurRadius="22" ShadowDepth="0" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- intestazione -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <Border DockPanel.Dock="Left" Background="{Binding Accent, ElementName=Root}" CornerRadius="6" Padding="10,3">
                    <TextBlock Text="{Binding Name, StringFormat=DECK {0}}" FontWeight="Black" Foreground="White" FontSize="13"/>
                </Border>
                <Border DockPanel.Dock="Left" Margin="6,0,0,0" Background="{StaticResource PanelAltBrush}" CornerRadius="4" Padding="6,2"
                        Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Muted}" FontWeight="Bold"/>
                </Border>
                <Button DockPanel.Dock="Right" Content="👎" Padding="6,2" FontSize="11" Margin="6,0,0,0" Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.DeckRejectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        ToolTip="Questo brano non c'entra dopo il precedente: il suggeritore e l'automix ne terranno conto"/>
                <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding FxVisible}" Content="⚡ FX" Padding="10,2" FontSize="11" FontWeight="Black" Margin="6,0,0,0" ToolTip="Mostra/nascondi effetti (filtro, echo, riverbero, flanger, EQ…)"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Singer, StringFormat=🎤 {0}}" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"
                           Visibility="{Binding Singer, Converter={StaticResource NullToVis}}" VerticalAlignment="Center"/>
                <TextBlock/>
            </DockPanel>

            <!-- titolo + controlli vinile (a destra) + riga dei tag genere -->
            <Grid Grid.Row="1">
                <Grid.Resources>
                    <Style x:Key="HoldBtn" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="Black"/>
                        <Setter Property="Margin" Value="0,0,3,0"/>
                        <Setter Property="MinWidth" Value="40"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Hold_Down"/>
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Hold_Up"/>
                        <EventSetter Event="MouseLeave" Handler="Hold_Leave"/>
                    </Style>
                    <Style x:Key="VinylBtn" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="Black"/>
                        <Setter Property="Margin" Value="0,0,3,0"/>
                        <Setter Property="MinWidth" Value="40"/>
                    </Style>
                    <Style x:Key="TagChip" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                        <Setter Property="Padding" Value="7,1"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Black" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Display, Segoe UI Black, Segoe UI"/>
                    <TextBlock Text="{Binding Artist}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- vinile: jog + comandi, accanto al titolo -->
                <DockPanel Grid.Column="1" Grid.Row="0" Margin="8,0,0,0" VerticalAlignment="Center">
                    <local:JogWheel x:Name="Jog" Width="52" Height="52" Accent="{Binding Accent, ElementName=Root}" Angle="{Binding JogAngle}" IsSpinning="{Binding IsPlaying}"
                                    JogStarted="Jog_Started" JogRateChanged="Jog_Rate" JogEnded="Jog_Ended" Nudged="Jog_Nudged" Margin="0,0,8,0"
                                    ToolTip="Piatto: trascina per fare scratch (anche all'indietro), rotella = pitch bend"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Button Style="{StaticResource HoldBtn}" Content="◀◀" Tag="backward" local:Shortcut.Action="back" ToolTip="Tieni premuto: indietro veloce con audio"/>
                            <Button Style="{StaticResource HoldBtn}" Content="▶▶" Tag="forward" local:Shortcut.Action="fwd" ToolTip="Tieni premuto: avanti veloce con audio"/>
                            <Button Style="{StaticResource HoldBtn}" Content="REV" Tag="reverse" local:Shortcut.Action="rev" ToolTip="Tieni premuto: riproduzione al contrario; al rilascio riprende"/>
                            <Button Style="{StaticResource HoldBtn}" Content="SLOW" Tag="slow" local:Shortcut.Action="slow" ToolTip="Tieni premuto: il disco rallenta fino a fermarsi; al rilascio riparte"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource VinylBtn}" Content="↶ SPIN" Command="{Binding SpinBackCommand}" local:Shortcut.Action="spinback" ToolTip="Girata secca all'indietro"/>
                            <Button Style="{StaticResource VinylBtn}" Content="SPIN ↷" Command="{Binding SpinForwardCommand}" local:Shortcut.Action="spinfwd" ToolTip="Girata secca in avanti"/>
                            <Button Style="{StaticResource VinylBtn}" Content="BRAKE" Command="{Binding BrakeCommand}" local:Shortcut.Action="brake" ToolTip="Frenata vinile fino allo stop (poi pausa)"/>
                            <Button Style="{StaticResource VinylBtn}" Content="BACKSPIN" Command="{Binding BackspinCommand}" local:Shortcut.Action="backspin" ToolTip="Riavvolgimento vinile (poi pausa)"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <!-- tag genere del brano caricato: click su un tag lo toglie, ＋ ne aggiunge (max 5) -->
                <DockPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,3,0,0" Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="🏷" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                    <Button DockPanel.Dock="Right" Content="＋ tag" Style="{StaticResource TagChip}" Foreground="{StaticResource MutedBrush}" Margin="0" Click="AddTag_Click"
                            ToolTip="Aggiungi un genere al brano (fino a 5). Elenco dei generi conosciuti, oppure scrivine uno nuovo."/>
                    <ItemsControl ItemsSource="{Binding GenreTags}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TagChip}" Content="{Binding}" Click="RemoveTag_Click" Tag="{Binding}" ToolTip="Click: togli questo genere dal brano"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>

            <!-- anteprima -->
            <Border Grid.Row="2" Background="Black" CornerRadius="4" Margin="0,4" Height="60" ClipToBounds="True"
                    Visibility="{Binding IsKaraoke, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Image Source="{Binding CdgBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"
                           Visibility="{Binding IsCdg, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="🎬 VIDEO sul proiettore" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="14"
                               Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="♪" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#333" FontSize="40"
                               Visibility="{Binding IsKaraoke, Converter={StaticResource BoolToVisInv}}"/>
                    <Border Background="#AAEF4444" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                            Visibility="{Binding IsEnding, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="FINE VICINA" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- barra di avanzamento -->
            <Grid Grid.Row="3" Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PositionLabel}" FontFamily="Consolas" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <local:WaveformView Grid.Column="1" x:Name="SeekBar" Height="56" Cursor="Hand"
                        Data="{Binding Waveform}" Progress="{Binding Progress}" IntroFraction="{Binding IntroFraction}" OutroFraction="{Binding OutroFraction}" LoopStart="{Binding LoopStartFraction}" LoopEnd="{Binding LoopEndFraction}"
                        BeatSec="{Binding BeatOffsetSec}" Bpm="{Binding NativeBpm}" DurationSec="{Binding DurationSec}" CueFraction="{Binding CueFraction}"
                        Accent="{Binding Accent, ElementName=Root}"
                        MouseLeftButtonDown="SeekBar_MouseDown" MouseMove="SeekBar_MouseMove" MouseRightButtonDown="SeekBar_RightDown"
                        ToolTip="Click: vai al punto. Tasto destro: intro/uscita, griglia dei battiti (battere qui, BPM ±), cue.">
                    <local:WaveformView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="⏩ Fine intro qui" Click="IntroHere_Click"/>
                            <MenuItem Header="⏪ Inizio uscita qui" Click="OutroHere_Click"/>
                            <Separator/>
                            <MenuItem Header="Fine intro = posizione attuale" Click="IntroNow_Click"/>
                            <MenuItem Header="Inizio uscita = posizione attuale" Click="OutroNow_Click"/>
                            <Separator/>
                            <MenuItem Header="Azzera intro/uscita" Click="ClearCues_Click"/>
                            <Separator/>
                            <MenuItem Header="🥁 Battere (1) qui — allinea la griglia" Click="BeatHere_Click" ToolTip="Il punto cliccato diventa un '1' della griglia dei battiti"/>
                            <MenuItem Header="🥁 Battere (1) = posizione attuale" Click="BeatNow_Click"/>
                            <MenuItem Header="Griglia dei battiti">
                                <MenuItem Header="BPM +0.1" Command="{Binding BpmAdjustCommand}" CommandParameter="+0.1"/>
                                <MenuItem Header="BPM −0.1" Command="{Binding BpmAdjustCommand}" CommandParameter="-0.1"/>
                                <MenuItem Header="BPM +1" Command="{Binding BpmAdjustCommand}" CommandParameter="+1"/>
                                <MenuItem Header="BPM −1" Command="{Binding BpmAdjustCommand}" CommandParameter="-1"/>
                                <MenuItem Header="BPM ×2" Command="{Binding BpmAdjustCommand}" CommandParameter="x2"/>
                                <MenuItem Header="BPM ÷2" Command="{Binding BpmAdjustCommand}" CommandParameter="/2"/>
                                <Separator/>
                                <MenuItem Header="Griglia +10 ms" Command="{Binding GridNudgeCommand}" CommandParameter="10"/>
                                <MenuItem Header="Griglia −10 ms" Command="{Binding GridNudgeCommand}" CommandParameter="-10"/>
                                <MenuItem Header="Griglia +50 ms" Command="{Binding GridNudgeCommand}" CommandParameter="50"/>
                                <MenuItem Header="Griglia −50 ms" Command="{Binding GridNudgeCommand}" CommandParameter="-50"/>
                                <Separator/>
                                <MenuItem Header="Ricalcola automaticamente" Command="{Binding GridAutoCommand}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="📍 Cue qui" Click="CueHere_Click"/>
                            <MenuItem Header="Cancella cue" Command="{Binding ClearCueCommand}"/>
                        </ContextMenu>
                    </local:WaveformView.ContextMenu>
                </local:WaveformView>
                <TextBlock Grid.Column="2" Text="{Binding RemainingLabel}" FontFamily="Consolas" FontSize="16" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,3,0,0">
                    <TextBlock Text="{Binding BpmLabel}" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Button Content="{Binding TapLabel}" local:Shortcut.Action="tap" Style="{StaticResource SmallButton}" Padding="6,0" FontSize="10" FontWeight="Black" Command="{Binding TapCommand}" Margin="0,0,10,0"
                            ToolTip="Tap tempo: batti il tempo con il click; dopo 4 tap i BPM del brano vengono corretti e salvati"/>
                    <TextBlock Text="{Binding KeyDisplay}" FontWeight="Bold" Foreground="#FF7DD3FC" Margin="0,0,10,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding IntroOutroLabel}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                    <TextBlock Text="USCITA" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding InOutro, Converter={StaticResource BoolToVis}}"/>
                </DockPanel>
            </Grid>

            <!-- trasporto -->
            <UniformGrid Grid.Row="4" Columns="6" Margin="0,0,0,4">
                <Button Style="{StaticResource IconButton}" Content="{Binding CueLabel}" local:Shortcut.Action="cue" FontSize="11" FontWeight="Black" Foreground="{StaticResource WarnBrush}" Command="{Binding CueCommand}" Margin="2"
                        ToolTip="CUE: in play → torna al cue e pausa · in pausa sul cue → riparte dal cue · in pausa altrove → imposta il cue qui. Doppio click destro: cancella il cue."
                        MouseRightButtonUp="Cue_Right"/>
                <Button Style="{StaticResource IconButton}" Content="⏹" local:Shortcut.Action="stop" ToolTip="Stop (torna a inizio)" Command="{Binding StopCommand}" Margin="2"/>
                <Button Style="{StaticResource IconButton}" Content="«10" local:Shortcut.Action="back10" FontSize="13" ToolTip="Indietro 10 s" Command="{Binding Back10Command}" Margin="2"/>
                <Button x:Name="PlayBtn" local:Shortcut.Action="play" FontSize="22" ToolTip="Play / Pausa" Command="{Binding TogglePlayCommand}" Margin="2"
                        IsEnabled="{Binding HasTrack}" Background="{Binding Accent, ElementName=Root}" Foreground="White" BorderBrush="Transparent">
                    <Button.Effect>
                        <DropShadowEffect Color="{Binding Accent.Color, ElementName=Root}" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Content" Value="▶"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="⏸"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="10»" local:Shortcut.Action="fwd10" FontSize="13" ToolTip="Avanti 10 s" Command="{Binding Forward10Command}" Margin="2"/>
                <Button Style="{StaticResource IconButton}" Content="⏏" local:Shortcut.Action="eject" ToolTip="Scarica il deck" Command="{Binding EjectCommand}" Margin="2"/>
            </UniformGrid>

            <!-- tonalità / tempo / volume -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BgBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TONALITÀ" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="−" Width="34" Height="34" FontSize="18" Padding="0" Command="{Binding KeyDownCommand}" local:Shortcut.Action="keydown"/>
                            <Button Width="50" Height="34" Padding="0" Command="{Binding KeyResetCommand}" local:Shortcut.Action="keyreset" ToolTip="Azzera" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="{Binding KeyLabel}" FontSize="22" FontWeight="Black" Foreground="{StaticResource WarnBrush}"/>
                            </Button>
                            <Button Content="+" Width="34" Height="34" FontSize="18" Padding="0" Command="{Binding KeyUpCommand}" local:Shortcut.Action="keyup"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock Text="TEMPO" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <Button DockPanel.Dock="Right" Content="0" Style="{StaticResource SmallButton}" Padding="6,0" Command="{Binding TempoResetCommand}" local:Shortcut.Action="temporeset"/>
                        <Button DockPanel.Dock="Right" Content="SYNC" Padding="6,0" FontSize="10" FontWeight="Black" Margin="0,0,4,0" Foreground="{StaticResource AccentBrush}"
                                Command="{Binding DataContext.SyncDeckCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" local:Shortcut.Action="sync"
                                ToolTip="Porta il tempo ai BPM dell'altro deck (o ai BPM bloccati)"/>
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding KeyLock}" Content="🔒 KEY" Padding="6,0" FontSize="10" Margin="0,0,4,0"
                                      ToolTip="Key lock (master tempo): acceso = cambiare velocità non cambia la tonalità; spento = il tono segue la velocità come un vinile"/>
                        <TextBlock Text="{Binding TempoLabel}" HorizontalAlignment="Right" Margin="8,0,6,0" FontWeight="Bold"/>
                    </DockPanel>
                    <Slider Minimum="-25" Maximum="25" Value="{Binding TempoPercent}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock Text="GAIN" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <Button DockPanel.Dock="Right" Content="0" Style="{StaticResource SmallButton}" Padding="6,0" Command="{Binding GainResetCommand}" ToolTip="Gain a 0 dB"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GainLabel}" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" MinWidth="58" TextAlignment="Right"/>
                        <local:LevelMeter Left="{Binding LevelL}" Right="{Binding LevelR}" Height="12" Margin="8,0,0,4" VerticalAlignment="Center" ToolTip="Uscita del deck (dopo gain e crossfader)"/>
                    </DockPanel>
                    <Slider Minimum="-24" Maximum="12" Value="{Binding GainDb}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                            ToolTip="Gain di ingresso del deck: pareggia il livello dei brani (0 dB = originale). Il livello in uscita si dosa col crossfader."
                            MouseDoubleClick="Gain_DoubleClick"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="PAN" Style="{StaticResource SectionTitle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PanLabel}" FontFamily="Consolas" FontWeight="Bold" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider Minimum="-1" Maximum="1" Value="{Binding Pan}" TickFrequency="1" TickPlacement="BottomRight" VerticalAlignment="Center" local:Shortcut.Action="pan"
                                ToolTip="Bilanciamento sinistra/destra del deck (doppio click = centro)" MouseDoubleClick="Pan_DoubleClick"/>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- EQ + loop -->
            <Grid Grid.Row="6" Margin="0,6,0,0">
                <Grid.Resources>
                    <Style x:Key="EqSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                        <Setter Property="Width" Value="46"/>
                        <Setter Property="Minimum" Value="-12"/>
                        <Setter Property="Maximum" Value="12"/>
                        <Setter Property="TickFrequency" Value="12"/>
                        <Setter Property="TickPlacement" Value="BottomRight"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="ToolTip" Value="EQ: −12 … +12 dB (centro = piatto). Doppio click = 0. Il pulsante accanto è il kill."/>
                        <EventSetter Event="MouseDoubleClick" Handler="Eq_DoubleClick"/>
                    </Style>
                    <Style x:Key="EqKill" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Padding" Value="4,1"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="Black"/>
                        <Setter Property="MinWidth" Value="28"/>
                    </Style>
                    <Style x:Key="LoopBtn" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                        <Setter Property="Padding" Value="5,1"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontFamily" Value="Consolas"/>
                        <Setter Property="Margin" Value="1,0"/>
                        <Setter Property="ToolTip" Value="Click: loop di N battute dalla posizione attuale. Tasto destro tenuto premuto: loop roll (al rilascio il brano riprende da dove sarebbe arrivato)"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="Loop_RightDown"/>
                        <EventSetter Event="PreviewMouseRightButtonUp" Handler="Loop_RightUp"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource EqKill}" Content="LOW" local:Shortcut.Action="killlow" IsChecked="{Binding EqLowKill}" ToolTip="Kill bassi"/>
                    <Slider Style="{StaticResource EqSlider}" Value="{Binding EqLow}" Foreground="{StaticResource MagentaBrush}"/>
                    <ToggleButton Style="{StaticResource EqKill}" Content="MID" local:Shortcut.Action="killmid" IsChecked="{Binding EqMidKill}" ToolTip="Kill medi"/>
                    <Slider Style="{StaticResource EqSlider}" Value="{Binding EqMid}" Foreground="{StaticResource WarnBrush}"/>
                    <ToggleButton Style="{StaticResource EqKill}" Content="HI" local:Shortcut.Action="killhigh" IsChecked="{Binding EqHighKill}" ToolTip="Kill alti"/>
                    <Slider Style="{StaticResource EqSlider}" Value="{Binding EqHigh}"/>
                    <Button Style="{StaticResource SmallButton}" Padding="4,1" FontSize="10" Content="↺" Command="{Binding EqResetCommand}" local:Shortcut.Action="eqreset" ToolTip="EQ piatto" MinWidth="22" Margin="2,0,8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LoopLabel}" Foreground="{StaticResource WarnBrush}" FontWeight="Black" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource LoopBtn}" Content="¼" Tag="0.25" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="½" Tag="0.5" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="1" Tag="1" local:Shortcut.Action="loop1" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="2" Tag="2" local:Shortcut.Action="loop2" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="4" Tag="4" local:Shortcut.Action="loop4" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="8" Tag="8" local:Shortcut.Action="loop8" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="÷2" local:Shortcut.Action="loophalf" Command="{Binding LoopHalfCommand}" ToolTip="Dimezza il loop"/>
                    <Button Style="{StaticResource LoopBtn}" Content="×2" local:Shortcut.Action="loopdouble" Command="{Binding LoopDoubleCommand}" ToolTip="Raddoppia il loop"/>
                    <Button Style="{StaticResource LoopBtn}" Content="EXIT" local:Shortcut.Action="loopexit" Command="{Binding LoopExitCommand}" ToolTip="Esci dal loop" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Grid>
            <!-- effetti -->
            <Border Grid.Row="7" Background="#FF0D0D12" CornerRadius="8" Padding="8,6" Margin="0,8,0,0"
                    Visibility="{Binding FxVisible, Converter={StaticResource BoolToVis}}">
                <Border.Resources>
                    <Style x:Key="FxToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Padding" Value="8,3"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Black"/>
                        <Setter Property="MinWidth" Value="62"/>
                    </Style>
                    <Style x:Key="FxSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                        <Setter Property="Width" Value="70"/>
                        <Setter Property="Margin" Value="4,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="FxLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Margin" Value="6,0,0,0"/>
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <ToggleButton Style="{StaticResource FxToggle}" IsChecked="{Binding VocalRemove}" Content="🎤 VOCE OFF" local:Shortcut.Action="vocaloff" ToolTip="Rimozione voce (cancellazione del centro). Funziona bene sui mix con voce al centro."/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding VocalStrength}" ToolTip="Intensità rimozione"/>
                        <ToggleButton Style="{StaticResource FxToggle}" IsChecked="{Binding FilterOn}" Content="FILTER" local:Shortcut.Action="filter" Margin="8,0,0,0" ToolTip="Filtro come effetto: acceso/spento senza perdere la posizione della manopola"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="{Binding FilterLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" MinWidth="44"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="RES"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding FilterResonance}" Width="44" ToolTip="Risonanza del filtro"/>
                        <Button DockPanel.Dock="Right" Content="ECHO OUT" Style="{StaticResource AccentButton}" local:Shortcut.Action="echoout" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                Command="{Binding EchoOutCommand}" ToolTip="Taglia il brano lasciando ripetere la coda dell'eco, poi mette in pausa"/>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource FxToggle}" IsChecked="{Binding FlangerOn}" Content="FLANGER" local:Shortcut.Action="flanger" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="reset" Style="{StaticResource SmallButton}" Padding="6,2" FontSize="10" Command="{Binding FilterResetCommand}"/>
                        <Slider Minimum="-1" Maximum="1" Value="{Binding FilterValue}" VerticalAlignment="Center" Margin="4,0" ToolTip="Sinistra = low-pass, destra = high-pass"/>
                    </DockPanel>
                    <DockPanel>
                        <ToggleButton Style="{StaticResource FxToggle}" IsChecked="{Binding EchoOn}" Content="ECHO" local:Shortcut.Action="echo"/>
                        <ToggleButton Style="{StaticResource FxToggle}" IsChecked="{Binding EchoPingPong}" Content="PING PONG" Margin="4,0,0,0" MinWidth="80" local:Shortcut.Action="pingpong" ToolTip="Le ripetizioni dell'eco rimbalzano fra sinistra e destra"/>
                        <Button Content="{Binding EchoBeatsLabel}" Style="{StaticResource SmallButton}" Padding="6,2" FontSize="11" FontFamily="Consolas" Command="{Binding EchoBeatsCycleCommand}" Margin="4,0,0,0" ToolTip="Tempo dell'eco in battute (agganciato ai BPM)"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="FB"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="0.9" Value="{Binding EchoFeedback}" Width="56"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="MIX"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding EchoMix}" Width="56"/>
                        <ToggleButton Style="{StaticResource FxToggle}" IsChecked="{Binding ReverbOn}" Content="REVERB" local:Shortcut.Action="reverb" Margin="10,0,0,0"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="SIZE"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding ReverbSize}" Width="50"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="MIX"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding ReverbMix}" Width="50"/>
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallButton}" Padding="6,2" FontSize="10" Command="{Binding FxResetCommand}" local:Shortcut.Action="fxreset" ToolTip="Spegne tutti gli effetti" Margin="4,0,0,0"/>
                        <TextBlock/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <ToggleButton Style="{StaticResource FxToggle}" IsChecked="{Binding PhaserOn}" Content="PHASER" local:Shortcut.Action="phaser"/>
                        <ToggleButton Style="{StaticResource FxToggle}" IsChecked="{Binding CrushOn}" Content="CRUSH" local:Shortcut.Action="crush" Margin="6,0,0,0" ToolTip="Bitcrusher (lo-fi)"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding CrushAmount}" Width="50"/>
                        <ToggleButton Style="{StaticResource FxToggle}" IsChecked="{Binding GateOn}" Content="GATE" local:Shortcut.Action="gate" Margin="6,0,0,0" ToolTip="Trans/gate a tempo"/>
                        <Button Content="{Binding GateBeatsLabel}" Style="{StaticResource SmallButton}" Padding="6,2" FontSize="11" FontFamily="Consolas" Command="{Binding GateBeatsCycleCommand}" Margin="4,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AiStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding AiVocalOff}" Content="🤖 VOCE AI" local:Shortcut.Action="aivocal" Padding="8,3" FontSize="11" FontWeight="Black" Margin="8,0,0,0"
                                      Command="{Binding ToggleAiVocalCommand}" ToolTip="Rimozione voce con Demucs (AI). La prima volta genera la base senza voce (1–3 min), poi si attiva/disattiva al volo."
                                      IsEnabled="{Binding IsSeparating, Converter={StaticResource InverseBool}}"/>
                        <TextBlock/>
                    </DockPanel>
                    <!-- stem: isola gli strumenti -->
                    <DockPanel Margin="0,6,0,0">
                        <ToggleButton Style="{StaticResource FxToggle}" IsChecked="{Binding StemsOn}" Content="🎚 STEMS" local:Shortcut.Action="stems" Command="{Binding ToggleStemsCommand}"
                                      IsEnabled="{Binding IsSeparating, Converter={StaticResource InverseBool}}"
                                      ToolTip="Isola gli strumenti: voce, batteria, basso e resto su 4 canali separati (Demucs AI). La prima volta genera gli stem (1–3 min)."/>
                        <Button DockPanel.Dock="Right" Content="↺" Style="{StaticResource SmallButton}" Padding="6,2" FontSize="10" Command="{Binding StemsResetCommand}" ToolTip="Tutti gli stem al 100%" Margin="4,0,0,0"/>
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding StemsOn}" Margin="6,0,0,0">
                            <StackPanel.Resources>
                                <Style x:Key="StemKill" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="Black"/>
                                    <Setter Property="MinWidth" Value="44"/>
                                </Style>
                                <Style x:Key="StemSolo" TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="FontSize" Value="9"/>
                                    <Setter Property="Margin" Value="1,0,6,0"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button Style="{StaticResource StemKill}" Content="VOCE" Command="{Binding StemKillCommand}" CommandParameter="vocals" ToolTip="Kill voce"/>
                            <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1.5" Value="{Binding StemVocals}" Width="56"/>
                            <Button Style="{StaticResource StemSolo}" Content="S" Command="{Binding StemSoloCommand}" CommandParameter="vocals" ToolTip="Solo voce (a cappella)"/>
                            <Button Style="{StaticResource StemKill}" Content="BATT" Command="{Binding StemKillCommand}" CommandParameter="drums" ToolTip="Kill batteria"/>
                            <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1.5" Value="{Binding StemDrums}" Width="56"/>
                            <Button Style="{StaticResource StemSolo}" Content="S" Command="{Binding StemSoloCommand}" CommandParameter="drums" ToolTip="Solo batteria"/>
                            <Button Style="{StaticResource StemKill}" Content="BASSO" Command="{Binding StemKillCommand}" CommandParameter="bass" ToolTip="Kill basso"/>
                            <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1.5" Value="{Binding StemBass}" Width="56"/>
                            <Button Style="{StaticResource StemSolo}" Content="S" Command="{Binding StemSoloCommand}" CommandParameter="bass" ToolTip="Solo basso"/>
                            <Button Style="{StaticResource StemKill}" Content="ALTRO" Command="{Binding StemKillCommand}" CommandParameter="other" ToolTip="Kill resto (chitarre, synth, tastiere…)"/>
                            <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1.5" Value="{Binding StemOther}" Width="56"/>
                            <Button Style="{StaticResource StemSolo}" Content="S" Command="{Binding StemSoloCommand}" CommandParameter="other" ToolTip="Solo resto"/>
                        </StackPanel>
                        <TextBlock/>
                    </DockPanel>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
