<UserControl x:Class="KaraokeDJ.Views.DeckControl" FontFamily="{StaticResource UiFont}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KaraokeDJ.Views"
             x:Name="Root">
    <UserControl.Resources>
        <!-- pulsanti della striscia trasporto: 26 px, etichette piccole -->
        <Style x:Key="StripBtn" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
        </Style>
        <Style x:Key="StripToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
        </Style>
        <Style x:Key="HoldBtn" TargetType="Button" BasedOn="{StaticResource StripBtn}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Hold_Down"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Hold_Up"/>
            <EventSetter Event="MouseLeave" Handler="Hold_Leave"/>
        </Style>
        <Style x:Key="LoopBtn" TargetType="Button" BasedOn="{StaticResource StripBtn}">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="ToolTip" Value="Click: loop di N battute dalla posizione attuale. Tasto destro tenuto premuto: loop roll (al rilascio il brano riprende da dove sarebbe arrivato)"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Loop_RightDown"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="Loop_RightUp"/>
        </Style>
        <Style x:Key="TagChip" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style x:Key="FxToggle" TargetType="ToggleButton" BasedOn="{StaticResource StripToggle}"><Setter Property="MinWidth" Value="56"/></Style>
        <Style x:Key="FxSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FxLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SectionToggle" TargetType="ToggleButton" BasedOn="{StaticResource StripToggle}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </UserControl.Resources>

    <!-- si può trascinare qui un brano dalla libreria: il bordo si illumina e al rilascio il brano viene caricato -->
    <Border Style="{StaticResource Panel}" BorderBrush="{Binding Accent, ElementName=Root}" BorderThickness="1" Padding="8"
            AllowDrop="True" DragOver="Deck_DragOver" DragLeave="Deck_DragLeave" Drop="Deck_Drop">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0 intestazione -->
                <RowDefinition Height="Auto"/>   <!-- 1 anteprima karaoke -->
                <RowDefinition Height="Auto"/>   <!-- 2 onda + fader tempo -->
                <RowDefinition Height="Auto"/>   <!-- 3 trasporto + loop -->
                <RowDefinition Height="Auto"/>   <!-- 4 hot cue + salti -->
                <RowDefinition Height="Auto"/>   <!-- 5 sezioni a scomparsa -->
                <RowDefinition Height="Auto"/>   <!-- 6 vinile -->
                <RowDefinition Height="Auto"/>   <!-- 7 fx -->
                <RowDefinition Height="Auto"/>   <!-- 8 stems -->
                <RowDefinition Height="Auto"/>   <!-- 9 tonalità -->
                <RowDefinition Height="Auto"/>   <!-- 10 tag -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.RowSpan="11" Panel.ZIndex="99" IsHitTestVisible="False" CornerRadius="3" BorderThickness="2" Margin="-6"
                    BorderBrush="{Binding Accent, ElementName=Root}" Background="#1AFFFFFF"
                    Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="CARICA QUI" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                           Foreground="{Binding Accent, ElementName=Root}" Opacity="0.85"/>
            </Border>

            <!-- ultimi 30 secondi: cornice rossa che pulsa -->
            <Border Grid.Row="0" Grid.RowSpan="11" IsHitTestVisible="False" CornerRadius="3" BorderBrush="{StaticResource DangerBrush}" BorderThickness="2" Background="#14FF3B3B" Margin="-8" Opacity="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnding}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="EndingPulse">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:0.45"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="EndingPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- ═══ intestazione: lettera deck, titolo/artista, BPM · tonalità · tempo ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{Binding Accent, ElementName=Root}" CornerRadius="2" Width="26" Height="34" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FF0B0B0F" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" Style="{StaticResource Muted}" FontSize="9.5" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock DockPanel.Dock="Right" Text="RIEMPIMENTO" Foreground="{StaticResource WarnBrush}" FontSize="9.5" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IsFill, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Singer, StringFormat=🎤 {0}}" FontSize="11" Foreground="{StaticResource WarnBrush}" Visibility="{Binding Singer, Converter={StaticResource NullToVis}}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <StackPanel Margin="0,0,12,0" MinWidth="64">
                        <TextBlock Text="{Binding BpmLabel}" FontSize="17" FontWeight="Medium" TextAlignment="Right" ToolTip="BPM effettivi (con il tempo del deck)"/>
                        <TextBlock Text="{Binding KeyDisplay}" FontSize="10.5" Foreground="{StaticResource AccentBrush}" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel MinWidth="64">
                        <TextBlock Text="{Binding PositionLabel}" FontFamily="Consolas" FontSize="17" TextAlignment="Right"/>
                        <TextBlock Text="{Binding RemainingLabel}" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextAlignment="Right"/>
                    </StackPanel>
                    <Button Content="👎" Style="{StaticResource StripBtn}" Margin="10,0,0,0" MinWidth="26" Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.DeckRejectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            ToolTip="Questo brano non c'entra dopo il precedente: il suggeritore e l'automix ne terranno conto"/>
                </StackPanel>
            </Grid>

            <!-- anteprima karaoke (CDG / video) -->
            <Border Grid.Row="1" Background="Black" CornerRadius="2" Margin="0,0,0,6" Height="56" ClipToBounds="True"
                    Visibility="{Binding IsKaraoke, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Image Source="{Binding CdgBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" Visibility="{Binding IsCdg, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="🎬 VIDEO sul proiettore" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"/>
                    <Border Background="#AAEF4444" CornerRadius="2" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Visibility="{Binding IsEnding, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="FINE VICINA" FontWeight="Medium" FontSize="10"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ onda + fader tempo verticale ═══ -->
            <Grid Grid.Row="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:WaveformView Grid.Row="0" x:Name="SeekBar" Height="84" Cursor="Hand"
                            Data="{Binding Waveform}" Fine="{Binding FineWaveform}" Progress="{Binding Progress}" IntroFraction="{Binding IntroFraction}" OutroFraction="{Binding OutroFraction}" LoopStart="{Binding LoopStartFraction}" LoopEnd="{Binding LoopEndFraction}"
                            BeatSec="{Binding BeatOffsetSec}" Bpm="{Binding NativeBpm}" DurationSec="{Binding DurationSec}" CueFraction="{Binding CueFraction}" HotCues="{Binding HotCueFractions}"
                            Accent="{Binding Accent, ElementName=Root}"
                            MouseLeftButtonDown="SeekBar_MouseDown" MouseMove="SeekBar_MouseMove" MouseRightButtonDown="SeekBar_RightDown"
                            ToolTip="Click: vai al punto. Tasto destro: intro/uscita, griglia dei battiti (battere qui, BPM ±), cue.">
                        <local:WaveformView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="⏩ Fine intro qui" Click="IntroHere_Click"/>
                                <MenuItem Header="⏪ Inizio uscita qui" Click="OutroHere_Click"/>
                                <Separator/>
                                <MenuItem Header="Fine intro = posizione attuale" Click="IntroNow_Click"/>
                                <MenuItem Header="Inizio uscita = posizione attuale" Click="OutroNow_Click"/>
                                <Separator/>
                                <MenuItem Header="Azzera intro/uscita" Click="ClearCues_Click"/>
                                <Separator/>
                                <MenuItem Header="🥁 Battere (1) qui — allinea la griglia" Click="BeatHere_Click" ToolTip="Il punto cliccato diventa un '1' della griglia dei battiti"/>
                                <MenuItem Header="🥁 Battere (1) = posizione attuale" Click="BeatNow_Click"/>
                                <MenuItem Header="Griglia dei battiti">
                                    <MenuItem Header="BPM +0.1" Command="{Binding BpmAdjustCommand}" CommandParameter="+0.1"/>
                                    <MenuItem Header="BPM −0.1" Command="{Binding BpmAdjustCommand}" CommandParameter="-0.1"/>
                                    <MenuItem Header="BPM +1" Command="{Binding BpmAdjustCommand}" CommandParameter="+1"/>
                                    <MenuItem Header="BPM −1" Command="{Binding BpmAdjustCommand}" CommandParameter="-1"/>
                                    <MenuItem Header="BPM ×2" Command="{Binding BpmAdjustCommand}" CommandParameter="x2"/>
                                    <MenuItem Header="BPM ÷2" Command="{Binding BpmAdjustCommand}" CommandParameter="/2"/>
                                    <Separator/>
                                    <MenuItem Header="Griglia +10 ms" Command="{Binding GridNudgeCommand}" CommandParameter="10"/>
                                    <MenuItem Header="Griglia −10 ms" Command="{Binding GridNudgeCommand}" CommandParameter="-10"/>
                                    <MenuItem Header="Griglia +50 ms" Command="{Binding GridNudgeCommand}" CommandParameter="50"/>
                                    <MenuItem Header="Griglia −50 ms" Command="{Binding GridNudgeCommand}" CommandParameter="-50"/>
                                    <Separator/>
                                    <MenuItem Header="Ricalcola automaticamente" Command="{Binding GridAutoCommand}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="📍 Cue qui" Click="CueHere_Click"/>
                                <MenuItem Header="Cancella cue" Command="{Binding ClearCueCommand}"/>
                            </ContextMenu>
                        </local:WaveformView.ContextMenu>
                    </local:WaveformView>
                    <DockPanel Grid.Row="1" Margin="0,3,0,0">
                        <TextBlock Text="{Binding LoopLabel}" Foreground="{StaticResource WarnBrush}" FontWeight="Medium" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="USCITA" Foreground="{StaticResource DangerBrush}" FontWeight="Medium" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding InOutro, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding IntroOutroLabel}" Style="{StaticResource Muted}" FontSize="9.5" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding AiStatus}" Style="{StaticResource Muted}" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
                <!-- tempo: fader verticale come sulla console, chiave sotto -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="58">
                    <TextBlock Text="{Binding TempoLabel}" FontSize="10.5" FontWeight="Medium" HorizontalAlignment="Center" MouseLeftButtonDown="TempoReset_Click" ToolTip="Tempo (click: 0 %)"/>
                    <Slider Minimum="-25" Maximum="25" Value="{Binding TempoPercent}" TickFrequency="1" IsSnapToTickEnabled="True" Width="74" HorizontalAlignment="Center" Margin="0,2" local:Shortcut.Action="tempo" ToolTip="Tempo ±25 %">
                        <Slider.LayoutTransform><RotateTransform Angle="-90"/></Slider.LayoutTransform>
                    </Slider>
                    <ToggleButton IsChecked="{Binding KeyLock}" Content="🔒 KEY" Style="{StaticResource StripToggle}" Height="20" FontSize="9" Padding="4,0" Margin="0" HorizontalAlignment="Stretch"
                                  ToolTip="Key lock (master tempo): acceso = cambiare velocità non cambia la tonalità"/>
                </StackPanel>
            </Grid>

            <!-- ═══ trasporto + loop ═══ -->
            <DockPanel Grid.Row="3" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource StripBtn}" Content="{Binding CueLabel}" local:Shortcut.Action="cue" Foreground="{StaticResource WarnBrush}" Command="{Binding CueCommand}" MinWidth="44"
                            ToolTip="CUE: in play → torna al cue e pausa · in pausa sul cue → riparte dal cue · in pausa altrove → imposta il cue qui. Doppio click destro: cancella." MouseRightButtonUp="Cue_Right"/>
                    <Button x:Name="PlayBtn" local:Shortcut.Action="play" Command="{Binding TogglePlayCommand}" Width="52" Height="26" Padding="0" FontSize="14" Margin="0,0,3,0"
                            IsEnabled="{Binding HasTrack}" Background="{Binding Accent, ElementName=Root}" Foreground="#FF0B0B0F" BorderBrush="Transparent" ToolTip="Play / Pausa">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▶"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Content" Value="⏸"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource StripBtn}" Content="SYNC" local:Shortcut.Action="sync" Foreground="{StaticResource AccentBrush}"
                            Command="{Binding DataContext.SyncDeckCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Porta il tempo ai BPM dell'altro deck (o ai BPM bloccati)"/>
                    <Button Style="{StaticResource StripBtn}" Content="{Binding TapLabel}" local:Shortcut.Action="tap" Command="{Binding TapCommand}" ToolTip="Tap tempo: dopo 4 tap i BPM del brano vengono corretti e salvati"/>
                    <Button Style="{StaticResource StripBtn}" Content="⏹" local:Shortcut.Action="stop" Command="{Binding StopCommand}" ToolTip="Stop (torna a inizio)"/>
                    <Button Style="{StaticResource StripBtn}" Content="⏏" local:Shortcut.Action="eject" Command="{Binding EjectCommand}" ToolTip="Scarica il deck"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="LOOP" Style="{StaticResource SectionTitle}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource LoopBtn}" Content="¼" Tag="0.25" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="½" Tag="0.5" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="1" Tag="1" local:Shortcut.Action="loop1" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="2" Tag="2" local:Shortcut.Action="loop2" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="4" Tag="4" local:Shortcut.Action="loop4" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="8" Tag="8" local:Shortcut.Action="loop8" Click="Loop_Click"/>
                    <Button Style="{StaticResource LoopBtn}" Content="÷2" local:Shortcut.Action="loophalf" Command="{Binding LoopHalfCommand}" ToolTip="Dimezza il loop"/>
                    <Button Style="{StaticResource LoopBtn}" Content="×2" local:Shortcut.Action="loopdouble" Command="{Binding LoopDoubleCommand}" ToolTip="Raddoppia il loop"/>
                    <Button Style="{StaticResource LoopBtn}" Content="EXIT" local:Shortcut.Action="loopexit" Command="{Binding LoopExitCommand}" ToolTip="Esci dal loop" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </DockPanel>

            <!-- ═══ hot cue 1–8 · Q · salti ═══ -->
            <DockPanel Grid.Row="4" Margin="0,0,0,6">
                <ToggleButton DockPanel.Dock="Left" Content="Q" IsChecked="{Binding Quantize}" local:Shortcut.Action="quantize" Style="{StaticResource StripToggle}" Width="26" MinWidth="0" Padding="0"
                              ToolTip="Quantizza: hot cue, loop e salti si agganciano al battito più vicino della griglia"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="3,0,0,0">
                    <Button Style="{StaticResource StripBtn}" Content="◀8" MinWidth="26" Padding="3,0" Command="{Binding BeatJumpCommand}" CommandParameter="-8" local:Shortcut.Action="jumpback8" ToolTip="Salta indietro di 8 battiti"/>
                    <Button Style="{StaticResource StripBtn}" Content="◀4" MinWidth="26" Padding="3,0" Command="{Binding BeatJumpCommand}" CommandParameter="-4" local:Shortcut.Action="jumpback4" ToolTip="Salta indietro di 4 battiti"/>
                    <Button Style="{StaticResource StripBtn}" Content="4▶" MinWidth="26" Padding="3,0" Command="{Binding BeatJumpCommand}" CommandParameter="4" local:Shortcut.Action="jumpfwd4" ToolTip="Salta avanti di 4 battiti"/>
                    <Button Style="{StaticResource StripBtn}" Content="8▶" MinWidth="26" Padding="3,0" Margin="0" Command="{Binding BeatJumpCommand}" CommandParameter="8" local:Shortcut.Action="jumpfwd8" ToolTip="Salta avanti di 8 battiti"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding HotCues}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Tag="{Binding Index}" Click="HotCue_Click" MouseRightButtonUp="HotCue_Right" Height="26" Padding="0" FontSize="10" FontWeight="Medium" Margin="0,0,3,0"
                                    ToolTip="Hot cue: vuoto → imposta qui · pieno → salta lì. Tasto destro: cancella.">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCue}" Value="True">
                                                <Setter Property="Background" Value="{Binding Color}"/>
                                                <Setter Property="Foreground" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- ═══ sezioni a scomparsa ═══ -->
            <StackPanel Grid.Row="5" Orientation="Horizontal">
                <ToggleButton Style="{StaticResource SectionToggle}" Content="VINILE" IsChecked="{Binding VinylVisible}" ToolTip="Piatto, scratch, reverse, brake, backspin"/>
                <ToggleButton Style="{StaticResource SectionToggle}" Content="FX" IsChecked="{Binding FxVisible}" ToolTip="Effetti: filtro, echo, riverbero, flanger, phaser, crush, gate, voce off"/>
                <ToggleButton Style="{StaticResource SectionToggle}" Content="STEMS" IsChecked="{Binding StemsVisible}" ToolTip="Isola voce, batteria, basso, resto (Demucs AI)"/>
                <ToggleButton Style="{StaticResource SectionToggle}" Content="TONALITÀ" IsChecked="{Binding KeyVisible}" ToolTip="Trasposizione ±12 semitoni, match armonico"/>
                <ToggleButton Style="{StaticResource SectionToggle}" Content="TAG" IsChecked="{Binding TagsVisible}" Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}" ToolTip="Generi del brano"/>
                <TextBlock Text="{Binding KeyLabel, StringFormat=tonalità {0}}" Style="{StaticResource Muted}" FontSize="9.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- vinile -->
            <DockPanel Grid.Row="6" Margin="0,6,0,0" Visibility="{Binding VinylVisible, Converter={StaticResource BoolToVis}}">
                <local:JogWheel x:Name="Jog" Width="56" Height="56" Accent="{Binding Accent, ElementName=Root}" Angle="{Binding JogAngle}" IsSpinning="{Binding IsPlaying}"
                                JogStarted="Jog_Started" JogRateChanged="Jog_Rate" JogEnded="Jog_Ended" Nudged="Jog_Nudged" Margin="0,0,10,0"
                                ToolTip="Piatto: trascina per fare scratch (anche all'indietro), rotella = pitch bend"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Button Style="{StaticResource HoldBtn}" Content="◀◀" Tag="backward" local:Shortcut.Action="back" ToolTip="Tieni premuto: indietro veloce con audio"/>
                        <Button Style="{StaticResource HoldBtn}" Content="▶▶" Tag="forward" local:Shortcut.Action="fwd" ToolTip="Tieni premuto: avanti veloce con audio"/>
                        <Button Style="{StaticResource HoldBtn}" Content="REV" Tag="reverse" local:Shortcut.Action="rev" ToolTip="Tieni premuto: riproduzione al contrario"/>
                        <Button Style="{StaticResource HoldBtn}" Content="SLOW" Tag="slow" local:Shortcut.Action="slow" ToolTip="Tieni premuto: il disco rallenta fino a fermarsi"/>
                        <Button Style="{StaticResource StripBtn}" Content="«10" local:Shortcut.Action="back10" Command="{Binding Back10Command}" ToolTip="Indietro 10 s"/>
                        <Button Style="{StaticResource StripBtn}" Content="10»" local:Shortcut.Action="fwd10" Command="{Binding Forward10Command}" ToolTip="Avanti 10 s"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource StripBtn}" Content="↶ SPIN" Command="{Binding SpinBackCommand}" local:Shortcut.Action="spinback" ToolTip="Girata secca all'indietro"/>
                        <Button Style="{StaticResource StripBtn}" Content="SPIN ↷" Command="{Binding SpinForwardCommand}" local:Shortcut.Action="spinfwd" ToolTip="Girata secca in avanti"/>
                        <Button Style="{StaticResource StripBtn}" Content="BRAKE" Command="{Binding BrakeCommand}" local:Shortcut.Action="brake" ToolTip="Frenata vinile fino allo stop"/>
                        <Button Style="{StaticResource StripBtn}" Content="BACKSPIN" Command="{Binding BackspinCommand}" local:Shortcut.Action="backspin" ToolTip="Riavvolgimento vinile"/>
                        <TextBlock Text="PAN" Style="{StaticResource FxLabel}"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="-1" Maximum="1" Value="{Binding Pan}" Width="70" local:Shortcut.Action="pan" ToolTip="Bilanciamento (doppio click = centro)" MouseDoubleClick="Pan_DoubleClick"/>
                        <TextBlock Text="{Binding PanLabel}" Style="{StaticResource FxLabel}" FontFamily="Consolas"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- effetti -->
            <Border Grid.Row="7" Background="{StaticResource InnerPanelBrush}" CornerRadius="2" Padding="8,6" Margin="0,6,0,0" Visibility="{Binding FxVisible, Converter={StaticResource BoolToVis}}">
                <WrapPanel ItemHeight="30" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding VocalRemove}" Content="VOCE OFF" local:Shortcut.Action="vocaloff" ToolTip="Rimozione voce (cancellazione del centro)"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding VocalStrength}" Width="50" ToolTip="Intensità rimozione"/>
                        <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding FilterOn}" Content="FILTER" local:Shortcut.Action="filter" Margin="6,0,3,0" ToolTip="Filtro on/off (la manopola è nel mixer)"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="{Binding FilterLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="Medium" MinWidth="40"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="RES"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding FilterResonance}" Width="44" ToolTip="Risonanza del filtro"/>
                        <Button Content="ECHO OUT" Style="{StaticResource AccentButton}" local:Shortcut.Action="echoout" Padding="10,0" Height="26" FontSize="10.5" Margin="0,0,3,0" VerticalAlignment="Center"
                                Command="{Binding EchoOutCommand}" ToolTip="Taglia il brano lasciando ripetere la coda dell'eco, poi mette in pausa"/>
                        <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding FlangerOn}" Content="FLANGER" local:Shortcut.Action="flanger" Margin="0,0,3,0"/>
                        <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding PhaserOn}" Content="PHASER" local:Shortcut.Action="phaser" Margin="0,0,3,0"/>
                        <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding EchoOn}" Content="ECHO" local:Shortcut.Action="echo"/>
                        <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding EchoPingPong}" Content="PING PONG" MinWidth="70" local:Shortcut.Action="pingpong" ToolTip="Le ripetizioni rimbalzano fra sinistra e destra"/>
                        <Button Content="{Binding EchoBeatsLabel}" Style="{StaticResource StripBtn}" FontFamily="Consolas" Command="{Binding EchoBeatsCycleCommand}" ToolTip="Tempo dell'eco in battute"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="FB"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="0.9" Value="{Binding EchoFeedback}" Width="46"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="MIX"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding EchoMix}" Width="46"/>
                        <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding ReverbOn}" Content="REVERB" local:Shortcut.Action="reverb" Margin="6,0,3,0"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="SIZE"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding ReverbSize}" Width="40"/>
                        <TextBlock Style="{StaticResource FxLabel}" Text="MIX"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding ReverbMix}" Width="40"/>
                        <Button Content="✕" Style="{StaticResource StripBtn}" MinWidth="26" Margin="0" Command="{Binding FxResetCommand}" local:Shortcut.Action="fxreset" ToolTip="Spegne tutti gli effetti"/>
                        <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding GateOn}" Content="GATE" local:Shortcut.Action="gate" ToolTip="Trans/gate a tempo"/>
                        <Button Content="{Binding GateBeatsLabel}" Style="{StaticResource StripBtn}" FontFamily="Consolas" Command="{Binding GateBeatsCycleCommand}"/>
                        <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding CrushOn}" Content="CRUSH" local:Shortcut.Action="crush" ToolTip="Bitcrusher (lo-fi)"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1" Value="{Binding CrushAmount}" Width="40"/>
                </WrapPanel>
            </Border>

            <!-- stem -->
            <Border Grid.Row="8" Background="{StaticResource InnerPanelBrush}" CornerRadius="2" Padding="8,6" Margin="0,6,0,0" Visibility="{Binding StemsVisible, Converter={StaticResource BoolToVis}}">
                <WrapPanel ItemHeight="30">
                    <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding StemsOn}" Content="STEMS" local:Shortcut.Action="stems" Command="{Binding ToggleStemsCommand}"
                                  IsEnabled="{Binding IsSeparating, Converter={StaticResource InverseBool}}"
                                  ToolTip="Isola gli strumenti su 4 canali (Demucs AI). La prima volta genera gli stem (1–3 min)."/>
                    <ToggleButton Style="{StaticResource FxToggle}" VerticalAlignment="Center" IsChecked="{Binding AiVocalOff}" Content="VOCE AI" local:Shortcut.Action="aivocal" Command="{Binding ToggleAiVocalCommand}"
                                  ToolTip="Rimozione voce con Demucs (AI): la prima volta genera la base senza voce, poi si attiva/disattiva al volo."
                                  IsEnabled="{Binding IsSeparating, Converter={StaticResource InverseBool}}"/>
                    <Button Content="↺" Style="{StaticResource StripBtn}" MinWidth="26" Margin="0" Command="{Binding StemsResetCommand}" ToolTip="Tutti gli stem al 100%"/>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding StemsOn}" Margin="6,0,0,0" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style x:Key="StemKill" TargetType="Button" BasedOn="{StaticResource StripBtn}"><Setter Property="MinWidth" Value="40"/><Setter Property="Padding" Value="4,0"/></Style>
                            <Style x:Key="StemSolo" TargetType="Button" BasedOn="{StaticResource StripBtn}"><Setter Property="MinWidth" Value="22"/><Setter Property="Padding" Value="3,0"/><Setter Property="FontSize" Value="9"/><Setter Property="Margin" Value="1,0,6,0"/></Style>
                        </StackPanel.Resources>
                        <Button Style="{StaticResource StemKill}" Content="VOCE" Command="{Binding StemKillCommand}" CommandParameter="vocals" ToolTip="Kill voce"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1.5" Value="{Binding StemVocals}" Width="46"/>
                        <Button Style="{StaticResource StemSolo}" Content="S" Command="{Binding StemSoloCommand}" CommandParameter="vocals" ToolTip="Solo voce"/>
                        <Button Style="{StaticResource StemKill}" Content="BATT" Command="{Binding StemKillCommand}" CommandParameter="drums" ToolTip="Kill batteria"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1.5" Value="{Binding StemDrums}" Width="46"/>
                        <Button Style="{StaticResource StemSolo}" Content="S" Command="{Binding StemSoloCommand}" CommandParameter="drums" ToolTip="Solo batteria"/>
                        <Button Style="{StaticResource StemKill}" Content="BASSO" Command="{Binding StemKillCommand}" CommandParameter="bass" ToolTip="Kill basso"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1.5" Value="{Binding StemBass}" Width="46"/>
                        <Button Style="{StaticResource StemSolo}" Content="S" Command="{Binding StemSoloCommand}" CommandParameter="bass" ToolTip="Solo basso"/>
                        <Button Style="{StaticResource StemKill}" Content="ALTRO" Command="{Binding StemKillCommand}" CommandParameter="other" ToolTip="Kill resto"/>
                        <Slider Style="{StaticResource FxSlider}" Minimum="0" Maximum="1.5" Value="{Binding StemOther}" Width="46"/>
                        <Button Style="{StaticResource StemSolo}" Content="S" Command="{Binding StemSoloCommand}" CommandParameter="other" ToolTip="Solo resto"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- tonalità -->
            <DockPanel Grid.Row="9" Margin="0,6,0,0" Visibility="{Binding KeyVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="TONALITÀ" Style="{StaticResource SectionTitle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <Button Content="−" Style="{StaticResource StripBtn}" MinWidth="30" Command="{Binding KeyDownCommand}" local:Shortcut.Action="keydown"/>
                <Button Style="{StaticResource StripBtn}" MinWidth="40" Command="{Binding KeyResetCommand}" local:Shortcut.Action="keyreset" ToolTip="Azzera" Content="{Binding KeyLabel}" Foreground="{StaticResource WarnBrush}" FontSize="13"/>
                <Button Content="+" Style="{StaticResource StripBtn}" MinWidth="30" Command="{Binding KeyUpCommand}" local:Shortcut.Action="keyup"/>
                <Button Content="♪ MATCH" Style="{StaticResource StripBtn}" Foreground="{StaticResource AccentBrush}" local:Shortcut.Action="keymatch"
                        Command="{Binding DataContext.KeyMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        ToolTip="Mixing armonico: trasporta (max ±3 semitoni) in una tonalità compatibile con l'altro deck"/>
            </DockPanel>
            <!-- tag genere: click su un tag lo toglie, ＋ ne aggiunge (max 5) -->
            <DockPanel Grid.Row="10" Margin="0,6,0,0" Visibility="{Binding TagsVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏷" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                    <ItemsControl ItemsSource="{Binding GenreTags}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TagChip}" Content="{Binding}" Click="RemoveTag_Click" Tag="{Binding}" ToolTip="Click: togli questo genere dal brano"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="＋ tag" Style="{StaticResource TagChip}" Foreground="{StaticResource MutedBrush}" Margin="0" Click="AddTag_Click" ToolTip="Aggiungi un genere al brano (fino a 5)"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
