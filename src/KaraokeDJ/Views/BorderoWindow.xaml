<Window x:Class="KaraokeDJ.Views.BorderoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borderò SIAE · programma musicale" Width="1100" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBgBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- intestazione evento -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,6,0"/>
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,3,14,3"/>
                    </Style>
                </Grid.Resources>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Organizzatore"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="Organizzatore" ToolTip="Chi ha richiesto il permesso SIAE (locale, associazione, privato)"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Locale / evento"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="Locale" ToolTip="Nome del locale o dell'evento"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Comune"/>
                <TextBox Grid.Row="0" Grid.Column="5" x:Name="Comune"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="DJ / esecutore"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="Esecutore"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="N. permesso SIAE"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="Permesso" ToolTip="Numero del permesso / licenza rilasciato dalla SIAE per la serata"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Data serata"/>
                <DockPanel Grid.Row="1" Grid.Column="5" Margin="0,3,14,3">
                    <Button DockPanel.Dock="Right" Content="⟳ Carica" Style="{StaticResource SmallButton}" Click="Reload_Click" Margin="6,0,0,0" ToolTip="Ricarica i brani riprodotti nell'intervallo"/>
                    <DatePicker x:Name="Giorno" Width="130" SelectedDateChanged="Range_Changed"/>
                    <TextBlock Text="dalle" Margin="8,0,4,0"/>
                    <TextBox x:Name="OraDa" Width="52" Text="18:00" Margin="0,0,4,0" TextAlignment="Center" ToolTip="Ora inizio (la serata può finire dopo mezzanotte: l'ora di fine vale per il giorno dopo)"/>
                    <TextBlock Text="alle" Margin="4,0,4,0"/>
                    <TextBox x:Name="OraA" Width="52" Text="06:00" Margin="0" TextAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Il programma musicale (borderò) richiede per ogni brano titolo e autori/compositori (non l'interprete). Gli autori vengono dal tag 'compositore' quando c'è: le righe con autori mancanti sono evidenziate, completale a mano (doppio click sulla cella). L'elenco si copia nel modulo SIAE online o si stampa/allega."/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock x:Name="Summary" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="Raggruppa" Content="raggruppa ripetizioni" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="Range_Changed" Unchecked="Range_Changed" ToolTip="Lo stesso brano eseguito più volte compare una volta con il numero di esecuzioni"/>
                <CheckBox x:Name="SoloMusica" Content="escludi basi karaoke" VerticalAlignment="Center" Margin="0,0,10,0" Checked="Range_Changed" Unchecked="Range_Changed"/>
                <Button Content="✨ Autori dai tag della libreria" Style="{StaticResource SmallButton}" Click="FillComposers_Click" Margin="0,0,6,0" ToolTip="Ricopia gli autori dal tag compositore dei file, dove presente"/>
                <Button Content="− Togli riga" Style="{StaticResource SmallButton}" Click="Remove_Click" Margin="0,0,6,0"/>
                <Button Content="＋ Aggiungi riga" Style="{StaticResource SmallButton}" Click="Add_Click" ToolTip="Brano eseguito ma non passato da VOXA (es. live)"/>
            </StackPanel>
            <TextBlock/>
        </DockPanel>

        <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Extended"
                  RowHeaderWidth="0" GridLinesVisibility="Horizontal">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MissingAuthors}" Value="True">
                            <Setter Property="Background" Value="#33FF2D6D"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="N." Binding="{Binding N}" Width="44" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ora" Binding="{Binding Ora}" Width="56" IsReadOnly="True"/>
                <DataGridTextColumn Header="Titolo" Binding="{Binding Titolo, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
                <DataGridTextColumn Header="Autori / compositori" Binding="{Binding Autori, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
                <DataGridTextColumn Header="Interprete" Binding="{Binding Interprete, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="Durata" Binding="{Binding Durata}" Width="64" IsReadOnly="True"/>
                <DataGridTextColumn Header="Esec." Binding="{Binding Volte, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Chiudi" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="🖨 Stampa / PDF" Style="{StaticResource AccentButton}" Click="Print_Click" Margin="0,0,8,0" ToolTip="Apre il programma musicale nel browser, pronto per la stampa o il salvataggio in PDF"/>
            <Button DockPanel.Dock="Right" Content="📄 Esporta CSV" Click="Csv_Click" Margin="0,0,8,0" ToolTip="Foglio per Excel / per l'import nel portale SIAE"/>
            <Button DockPanel.Dock="Right" Content="📋 Copia elenco" Click="Copy_Click" Margin="0,0,8,0" ToolTip="Copia le righe (titolo, autori, interprete, durata) da incollare nel modulo online"/>
            <TextBlock x:Name="Status" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
