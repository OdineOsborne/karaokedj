<Window x:Class="KaraokeDJ.Views.PreflightWindow" FontFamily="{StaticResource BrandFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mixfonia – Controllo pre-serata" Width="720" Height="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CONTROLLO PRE-SERATA" Style="{StaticResource SectionTitle}"/>
        <TextBlock Grid.Row="1" x:Name="SummaryText" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,14" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,7" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontWeight="Black" FontSize="16" Width="26" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Foreground" Value="#FF37D67A"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Fail"><Setter Property="Foreground" Value="#FFE05252"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding What}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Advice}" Foreground="{StaticResource WarnBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding Advice, Converter={StaticResource NullToVis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       Text="Da fare mezz'ora prima di cominciare, con tutto già collegato."/>
            <Button DockPanel.Dock="Right" Content="Chiudi" Click="Close_Click" MinWidth="90" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Copia" Click="Copy_Click" Style="{StaticResource SmallButton}" MinWidth="90" Margin="8,0,0,0" ToolTip="Copia l'elenco negli appunti"/>
            <Button DockPanel.Dock="Right" Content="Ricontrolla" Click="Recheck_Click" Style="{StaticResource SmallButton}" MinWidth="90" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
