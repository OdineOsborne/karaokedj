<Window x:Class="KaraokeDJ.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Width="680" Height="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="14,6" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="12">
            <!-- ═══ generale ═══ -->
            <TabItem Header="Generale">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AUDIO" Style="{StaticResource SectionTitle}"/>
                    <DockPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="Uscita audio" Width="140" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DeviceCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </DockPanel>

                    <TextBlock Grid.Row="2" Text="PROIETTORE / SECONDO SCHERMO" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Schermo" Width="140" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ScreenCombo"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Titolo di attesa" Width="140" VerticalAlignment="Center"/>
                            <TextBox x:Name="IdleTitleBox"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Sottotitolo" Width="140" VerticalAlignment="Center"/>
                            <TextBox x:Name="IdleSubtitleBox"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Offset testi (ms)" Width="140" VerticalAlignment="Center" ToolTip="Positivo = i testi/video anticipano rispetto all'audio"/>
                            <TextBlock x:Name="OffsetLabel" DockPanel.Dock="Right" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                            <Slider x:Name="OffsetSlider" Minimum="-500" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OffsetSlider_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CARTELLE LIBRERIA" Style="{StaticResource SectionTitle}"/>
                        <ListBox Grid.Row="1" x:Name="FoldersList"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Aggiungi…" Click="AddFolder_Click" Margin="0,0,6,0"/>
                            <Button Content="Rimuovi" Click="RemoveFolder_Click" Margin="0,0,6,0"/>
                            <Button Content="Aggiorna yt-dlp" Click="UpdateYtDlp_Click" ToolTip="Se i download da YouTube smettono di funzionare, aggiorna yt-dlp" Margin="0,0,6,0"/>
                            <Button Content="🤖 Installa motore AI (Demucs)" Click="InstallAi_Click" ToolTip="Python + PyTorch CPU + Demucs (~300 MB). Serve per la rimozione voce AI." Margin="0,0,6,0"/>
                            <Button Content="⬆ Cerca aggiornamenti" Command="{Binding CheckUpdatesCommand}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ MIDI ═══ -->
            <TabItem Header="Controller MIDI">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Dispositivo MIDI" Width="140" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Collega" Click="MidiConnect_Click" Margin="6,0,0,0"/>
                        <ComboBox x:Name="MidiCombo"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock x:Name="MidiActivity" Style="{StaticResource Muted}" Text="Nessun messaggio ricevuto" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right" Text="Premi «Impara» e poi muovi la manopola / premi il tasto sul controller"/>
                    </DockPanel>
                    <ListBox Grid.Row="2" x:Name="MidiList" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Binding}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <Button Grid.Column="2" Content="{Binding LearnLabel}" Style="{StaticResource SmallButton}" Click="MidiLearn_Click" Tag="{Binding}" Margin="4,0" MinWidth="70"/>
                                    <Button Grid.Column="3" Content="✕" Style="{StaticResource SmallButton}" Click="MidiClear_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="InfoLabel" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Annulla" IsCancel="True" Margin="0,0,6,0"/>
            <Button Content="Salva" Style="{StaticResource AccentButton}" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
