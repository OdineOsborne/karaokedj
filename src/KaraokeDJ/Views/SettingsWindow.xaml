<Window x:Class="KaraokeDJ.Views.SettingsWindow" FontFamily="{StaticResource UiFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Width="860" Height="700" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="14,6" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="12">
            <!-- ═══ generale ═══ -->
            <TabItem Header="Generale">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AUDIO / AI" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Uscita audio" Width="140" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DeviceCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Cuffia (pre-ascolto)" Width="140" VerticalAlignment="Center" ToolTip="Seconda scheda audio per il pre-ascolto: i deck con 🎧 acceso si sentono qui, mescolati col master dalla manopola CUE del mixer."/>
                            <ComboBox x:Name="CueCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Microfono" Width="140" VerticalAlignment="Center" ToolTip="Ingresso del microfono: gain, eco/riverbero e talk-over dal blocco MIC del mixer."/>
                            <ComboBox x:Name="MicCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Cartella download" Width="140" VerticalAlignment="Center" ToolTip="Dove salvare MP3/video scaricati (sottocartelle per playlist e Suno)"/>
                            <Button DockPanel.Dock="Right" Content="Sfoglia…" Click="BrowseDownload_Click" Margin="6,0,0,0"/>
                            <TextBox x:Name="DownloadFolderBox"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Chiave API Anthropic" Width="140" VerticalAlignment="Center" ToolTip="Per generare i testi delle canzoni (Animazione). Salvata cifrata per l'utente Windows."/>
                            <PasswordBox x:Name="ApiKeyBox" Background="{StaticResource InnerPanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="6,4"/>
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="PROIETTORE / SECONDO SCHERMO" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="3" Margin="0,0,0,14">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Schermo" Width="140" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ScreenCombo"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Titolo di attesa" Width="140" VerticalAlignment="Center"/>
                            <TextBox x:Name="IdleTitleBox"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Sottotitolo" Width="140" VerticalAlignment="Center"/>
                            <TextBox x:Name="IdleSubtitleBox"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Statistiche d'uso" Width="140" VerticalAlignment="Center" ToolTip="Facoltative: aiutano a capire quali passaggi funzionano in serata. Nessun dato personale."/>
                            <Button DockPanel.Dock="Right" Content="Cancella" Style="{StaticResource SmallButton}" Click="UsageClear_Click" Margin="6,0,0,0" ToolTip="Butta via i dati in attesa su questo PC"/>
                            <Button DockPanel.Dock="Right" Content="Guarda cosa mando" Style="{StaticResource SmallButton}" Click="UsageShow_Click" Margin="6,0,0,0"/>
                            <CheckBox x:Name="UsageBox" Content="Condividi i passaggi della serata (anonimi) per migliorare i suggerimenti" VerticalAlignment="Center" Click="UsageBox_Click"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Dimensione interfaccia" Width="140" VerticalAlignment="Center" ToolTip="Su schermi piccoli l'interfaccia si rimpicciolisce da sola: qui puoi fissarla. Anche con Ctrl + / Ctrl − / Ctrl 0."/>
                            <TextBlock x:Name="ScaleNow" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <ComboBox x:Name="ScaleCombo" SelectionChanged="ScaleCombo_Changed" MaxWidth="220" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Aspetto" Width="140" VerticalAlignment="Center"/>
                            <CheckBox x:Name="GlassBox" Content="Effetto vetro dietro la finestra (Windows 11, riavvio)" VerticalAlignment="Center" ToolTip="Sfondo Mica: i pannelli semitrasparenti lasciano intravedere il desktop. Se non ti piace o dà problemi grafici, toglilo."/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Offset testi (ms)" Width="140" VerticalAlignment="Center" ToolTip="Positivo = i testi/video anticipano rispetto all'audio"/>
                            <TextBlock x:Name="OffsetLabel" DockPanel.Dock="Right" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                            <Slider x:Name="OffsetSlider" Minimum="-500" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OffsetSlider_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CARTELLE LIBRERIA" Style="{StaticResource SectionTitle}"/>
                        <ListBox Grid.Row="1" x:Name="FoldersList"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Aggiungi…" Click="AddFolder_Click" Margin="0,0,6,0"/>
                            <Button Content="Rimuovi" Click="RemoveFolder_Click" Margin="0,0,6,0"/>
                            <Button Content="🤖 Installa motore AI (Demucs)" Click="InstallAi_Click" ToolTip="Python + PyTorch CPU + Demucs (~300 MB). Serve per la rimozione voce AI." Margin="0,0,6,0"/>
                            <Button Content="🏷 Generi con AI" Command="{Binding ClassifyGenresCommand}" ToolTip="Assegna genere e anno ai brani senza tag (Claude, a lotti). Migliora suggeriti e continuità dell'automix. Clicca di nuovo per interrompere." Margin="0,0,6,0"/>
                            <Button Content="⬆ Cerca aggiornamenti" Command="{Binding CheckUpdatesCommand}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══ MIDI ═══ -->
            <TabItem Header="MIDI e tastiera">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Dispositivo MIDI" Width="140" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Collega" Click="MidiConnect_Click" Margin="6,0,0,0"/>
                        <ComboBox x:Name="MidiCombo"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource InnerPanelBrush}" CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Mappatura di fabbrica" Style="{StaticResource SmallButton}" Command="{Binding ResetControllerMappingCommand}" Margin="8,0,0,0"
                                        ToolTip="Cancella le mappature imparate e torna al preset della console"/>
                                <TextBlock Text="{Binding ControllerStatus}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" x:Name="SupportedList"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Importa mappatura…" Style="{StaticResource SmallButton}" Click="MidiImport_Click" Margin="0,0,6,0"
                                        ToolTip="File JSON Mixfonia, XML di Mixxx (*.midi.xml: oltre 200 console su github.com/mixxxdj/mixxx/tree/main/res/controllers) o djay (*.djayMidiMapping)"/>
                                <Button Content="Esporta la mia mappatura…" Style="{StaticResource SmallButton}" Click="MidiExport_Click" Margin="0,0,6,0"
                                        ToolTip="Salva preset + correzioni della console collegata in un file JSON da tenere o da condividere"/>
                                <ToggleButton Content="Registra cosa manda la console" IsChecked="{Binding MidiLogging, Mode=OneWay}" Command="{Binding ToggleMidiLogCommand}" Style="{StaticResource ToolToggle}" Padding="8,2" Height="24" MinWidth="0" FontSize="11" Margin="0,0,6,0"
                                        ToolTip="Scrive in un file ogni messaggio MIDI ricevuto e l'azione collegata. Serve per capire perché un controllo non risponde: registra, muovi quel controllo, ferma e mandami il file (%AppData%KaraokeDJmidi-log.txt)."/>
                                                                <Button Content="Cartella mappature" Style="{StaticResource SmallButton}" Click="MidiFolder_Click" Margin="0,0,6,0"
                                        ToolTip="Le mappature tue stanno qui: un file JSON per console, vincono su quelle dell'app"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock x:Name="MidiActivity" Style="{StaticResource Muted}" Text="Nessun messaggio ricevuto" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Right" Text="«Impara MIDI» poi muovi il controllo sulla console · «inverti» se lavora al contrario · «encoder» per le manopole senza fine corsa · «Impara tasto» per la tastiera. Nell'app: tasto destro su un comando fa lo stesso."/>
                    </DockPanel>
                    <ListBox Grid.Row="3" x:Name="MidiList" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Binding}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <Button Grid.Column="2" Content="{Binding LearnLabel}" Style="{StaticResource SmallButton}" Click="MidiLearn_Click" Tag="{Binding}" Margin="4,0" MinWidth="90"/>
                                    <Button Grid.Column="3" Content="✕" Style="{StaticResource SmallButton}" Click="MidiClear_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,12,0" Visibility="{Binding FlagsVisible}">
                                        <CheckBox Content="inverti" IsChecked="{Binding Invert}" Click="MidiFlags_Click" Tag="{Binding}" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" ToolTip="Il fader/manopola lavora al contrario"/>
                                        <CheckBox Content="encoder" IsChecked="{Binding Relative}" Click="MidiFlags_Click" Tag="{Binding}" VerticalAlignment="Center" FontSize="11" ToolTip="Manopola senza fine corsa (manda + e −), non una posizione"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="5" Text="{Binding KeyBinding}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <Button Grid.Column="6" Content="{Binding KeyLearnLabel}" Style="{StaticResource SmallButton}" Click="KeyLearn_Click" Tag="{Binding}" Margin="4,0" MinWidth="90"/>
                                    <Button Grid.Column="7" Content="✕" Style="{StaticResource SmallButton}" Click="KeyClear_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <!-- ═══ PLUGIN E FONTI ═══ -->
            <TabItem Header="Plugin e fonti">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="FONTI DI IMPORTAZIONE INTEGRATE (lecite e gratuite)" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,6"
                                   Text="Audius (brani resi scaricabili dagli artisti, senza chiave) · Internet Archive (audio con licenza libera / pubblico dominio, senza chiave) · Jamendo (Creative Commons, serve un client_id gratuito)."/>
                        <DockPanel>
                            <TextBlock Text="Jamendo client_id" Width="140" VerticalAlignment="Center"/>
                            <TextBox x:Name="JamendoBox" ToolTip="Gratuito: registrati su developer.jamendo.com e crea un'app; incolla qui il client_id"/>
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}">
                            <Run Text="Servizi a pagamento con licenza per DJ (si integrano come plugin, in arrivo): "/>
                            <Hyperlink NavigateUri="https://www.beatport.com/link" RequestNavigate="Link_Click">Beatport LINK</Hyperlink><Run Text=" · "/>
                            <Hyperlink NavigateUri="https://www.beatsource.com/link" RequestNavigate="Link_Click">Beatsource LINK</Hyperlink><Run Text=" · "/>
                            <Hyperlink NavigateUri="https://tidal.com/dj" RequestNavigate="Link_Click">TIDAL per DJ</Hyperlink><Run Text=" · "/>
                            <Hyperlink NavigateUri="https://soundcloud.com/go" RequestNavigate="Link_Click">SoundCloud Go+</Hyperlink>
                            <Run Text=". Gratuiti: "/>
                            <Hyperlink NavigateUri="https://audius.co" RequestNavigate="Link_Click">Audius</Hyperlink><Run Text=" · "/>
                            <Hyperlink NavigateUri="https://www.jamendo.com" RequestNavigate="Link_Click">Jamendo</Hyperlink><Run Text=" · "/>
                            <Hyperlink NavigateUri="https://freemusicarchive.org" RequestNavigate="Link_Click">Free Music Archive</Hyperlink><Run Text=" · "/>
                            <Hyperlink NavigateUri="https://archive.org/details/audio" RequestNavigate="Link_Click">Internet Archive</Hyperlink>
                            <Run Text=". Le basi karaoke commerciali (Karafun, Sunfly, Zoom) si acquistano e si importano come file."/>
                        </TextBlock>
                    </StackPanel>
                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock Text="PLUGIN INSTALLATI" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="📦 Installa plugin…" Style="{StaticResource SmallButton}" Click="InstallPlugin_Click" Margin="0,0,6,0" ToolTip="Scegli lo zip (o la DLL) del plugin: viene copiato nella cartella plugin. Poi riavvia Mixfonia."/>
                            <Button Content="📁 Apri cartella" Style="{StaticResource SmallButton}" Click="OpenPlugins_Click" ToolTip="%AppData%\KaraokeDJ\plugins"/>
                        </StackPanel>
                        <TextBlock/>
                    </DockPanel>
                    <ListBox Grid.Row="3" x:Name="PluginList" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="{Binding MaintenanceLabel}" Style="{StaticResource SmallButton}" Click="PluginMaintenance_Click" Tag="{Binding}"
                                            Visibility="{Binding MaintenanceLabel, Converter={StaticResource NullToVis}}" Margin="6,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="InfoLabel" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Annulla" IsCancel="True" Margin="0,0,6,0"/>
            <Button Content="Salva" Style="{StaticResource AccentButton}" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
