<Window x:Class="KaraokeDJ.Views.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scaletta remota · QR" Width="560" Height="640" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,10"
                   Text="Inquadra il QR col telefono: vedi cosa suona, la coda e i suggeriti; cerchi nella libreria, metti in coda, riordini, togli, e con MIX NOW passi al prossimo. Serve internet (passa dal cloud VOXA). Al telefono viene chiesto il PIN qui sotto."/>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="Qr" Width="320" Height="320" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Muted}" Text="PIN da inserire sul telefono"/>
            <TextBlock x:Name="PinText" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="44" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="UrlText" HorizontalAlignment="Center" Style="{StaticResource Muted}" FontFamily="Consolas" Cursor="Hand" MouseLeftButtonUp="Url_Click" ToolTip="Click: copia il link"/>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Chiudi" IsCancel="True" ToolTip="La scaletta remota resta attiva finché VOXA è aperto"/>
            <Button DockPanel.Dock="Right" x:Name="StopBtn" Content="⏹ Disattiva" Click="Stop_Click" Margin="0,0,8,0" ToolTip="Chiude la sessione: il telefono non vede più nulla"/>
            <Button DockPanel.Dock="Right" Content="🔁 Nuovo PIN" Click="NewPin_Click" Margin="0,0,8,0" ToolTip="Se il PIN è finito in mani sbagliate"/>
            <Button Content="🖥 Mostra sul proiettore" Click="Projector_Click" ToolTip="Il QR compare grande sullo schermo del proiettore per qualche secondo (per far entrare un collega)"/>
        </DockPanel>
    </Grid>
</Window>
