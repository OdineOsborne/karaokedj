<Window x:Class="KaraokeDJ.Views.ProjectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="VOXA – Proiettore" Background="Black" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="True" Cursor="None" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- banner "prossimo cantante", riusato sopra CDG e sopra il video -->
        <DataTemplate x:Key="NextBanner">
            <Border Background="#B0000000" CornerRadius="12" Padding="26,12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                    Visibility="{Binding NextSingers.Count, Converter={StaticResource NullToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PROSSIMO: " FontSize="28" FontWeight="Bold" Foreground="#FF00E5FF" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NextSingers[0]}" FontSize="28" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- ═══ schermo di attesa ═══ -->
        <Grid x:Name="IdleLayer">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#FF2A1560" Offset="0"/>
                    <GradientStop Color="#FF0B0B0F" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo-ext.png" Width="720" Margin="0,0,0,30" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#FF8A2BFF" Opacity="0.7"/></Image.Effect>
                </Image>
                <TextBlock Text="{Binding IdleTitle}" FontSize="72" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#FF00E5FF" Opacity="0.8"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding IdleSubtitle}" FontSize="32" Foreground="#FFB8C0D8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="700"
                        Visibility="{Binding NextSingers.Count, Converter={StaticResource NullToVis}}">
                <TextBlock Text="PROSSIMI CANTANTI" FontSize="26" FontWeight="Bold" Foreground="#FF00E5FF" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding NextSingers}" AlternationCount="100">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="34" Foreground="White" HorizontalAlignment="Center" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- ═══ DEDICA (serata Animazione) ═══ -->
        <Grid x:Name="DedicationLayer" Visibility="Collapsed">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.4" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#FF3A0A2E" Offset="0"/>
                    <GradientStop Color="#FF07080F" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="1" Text="{Binding DedicationTitle}" FontSize="80" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1600" Margin="40,0">
                <TextBlock.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#FFFF2D95" Opacity="0.9"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock Grid.Row="2" Text="{Binding DedicationText}" FontSize="36" Foreground="#FFFFD60A" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1500" Margin="40,24,40,0" LineHeight="52"/>
        </Grid>

        <!-- ═══ TESTO MIDI/KAR ═══ -->
        <Grid x:Name="LyricsLayer" Background="#FF05060C" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="1" Text="{Binding ActiveKaraokeDeck.LyricPrev}" FontSize="54" Foreground="#80FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1700" Margin="40,0,40,18"/>
            <TextBlock Grid.Row="2" FontSize="84" FontWeight="Black" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1700" Margin="40,0">
                <Run Text="{Binding ActiveKaraokeDeck.LyricSung, Mode=OneWay}" Foreground="#FF00E5FF"/><Run Text="{Binding ActiveKaraokeDeck.LyricRest, Mode=OneWay}" Foreground="White"/>
                <TextBlock.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#FF8A2BFF" Opacity="0.8"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock Grid.Row="3" Text="{Binding ActiveKaraokeDeck.LyricNext}" FontSize="54" Foreground="#A0FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1700" Margin="40,18,40,0"/>
            <ContentPresenter Grid.Row="4" ContentTemplate="{StaticResource NextBanner}" Content="{Binding}" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- ═══ CDG ═══ -->
        <Grid x:Name="CdgLayer" Background="Black" Visibility="Collapsed">
            <Image x:Name="CdgImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
            <ContentPresenter ContentTemplate="{StaticResource NextBanner}" Content="{Binding}"/>
        </Grid>

        <!-- ═══ VIDEO ═══ -->
        <vlc:VideoView x:Name="VideoView" Visibility="Collapsed" Background="Black">
            <Grid>
                <ContentPresenter ContentTemplate="{StaticResource NextBanner}" Content="{Binding}"/>
            </Grid>
        </vlc:VideoView>

        <!-- ═══ QR (scaletta remota / richieste) mostrato per qualche secondo sopra tutto ═══ -->
        <Border x:Name="QrLayer" Visibility="{Binding QrOverlayVisible, Converter={StaticResource BoolToVis}}" Background="#CC000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="24" Padding="28">
                    <Image Source="{Binding QrOverlayImage}" Width="520" Height="520" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <TextBlock Text="{Binding QrOverlayCaption}" FontSize="44" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" Margin="0,24,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
