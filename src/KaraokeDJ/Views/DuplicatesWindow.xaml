<Window x:Class="KaraokeDJ.Views.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulizia doppioni" Width="980" Height="680" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBgBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" x:Name="ScanBtn" Content="🔍 Cerca doppioni" Style="{StaticResource AccentButton}" Click="Scan_Click"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Cerca file identici e brani uguali (stesso artista e titolo, durata simile). Per ogni gruppo viene tenuta la copia migliore (qualità, tag, analisi); le altre vanno nel Cestino, quindi recuperabili."/>
        </DockPanel>
        <ListBox Grid.Row="1" x:Name="List" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FF0D0D12" CornerRadius="8" Padding="10" Margin="0,2">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Saved}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource SectionTitle}" Margin="0" Foreground="{StaticResource AccentBrush}"/>
                            </DockPanel>
                            <TextBlock Margin="0,4,0,2"><Run Text="✓ tengo: " Foreground="{StaticResource AccentABrush}" FontWeight="Bold"/><Run Text="{Binding KeepText, Mode=OneWay}"/></TextBlock>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected}" Margin="0,2">
                                            <TextBlock TextTrimming="CharacterEllipsis"><Run Text="🗑 " Foreground="{StaticResource DangerBrush}"/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" x:Name="DeleteBtn" Content="🗑 Sposta nel Cestino i selezionati" Style="{StaticResource DangerButton}" Click="Delete_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" Content="Chiudi" IsCancel="True" Margin="0,0,8,0"/>
            <TextBlock x:Name="Status" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
